# Dependencies and generated output. Rebuild with `npm install` and
# `./build-deploy.sh`; netlify-deploy/ is a mirror of public/ and is never
# the editing source.
node_modules
netlify-deploy/
.netlify/
# Android app build output (./android/build-apk.sh). The signing key android/bladefall.keystore is NOT
# ignored on purpose: every update must be signed with it.
android/build/
android/dist/

# OS, editor and local tooling state.
.DS_Store
/.claude/

# Historical evidence media: screenshots, contact sheets and route recordings
# captured from past builds. They are archival proof, not the record the game
# is built from, and they add ~170 MB to every clone. Keep them in the separate
# local archive; the receipts, prose and JSON beside them stay tracked.
docs/**/*.png
docs/**/*.jpg
docs/**/*.jpeg
docs/**/*.gif
docs/**/*.mp4
docs/**/*.webm
scripts/climb/.cache/

# Local playtest submissions and private deployment seed
scripts/playtest-release/.cache/
netlify/functions/playtest-seed.json

# Cloudflare local state and dry-run bundles
.wrangler/
cloudflare-dist/
.dev.vars

# Private local release snapshots; not application source.
scripts/playtest-release/before/
