    "composition": {
      "movement": "Reverse super with late input grace",
      "entity": "Recoil plate",
      "dependency": "Compression exposes a low tally; the same plate's released upward motion raises the opposite return launch, which must keep its one phase change."
    },
    "review": {
      "decision": "banked",
      "comment": "Approved as an easier Base-game component."
    },
