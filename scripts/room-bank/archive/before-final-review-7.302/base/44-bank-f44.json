    "composition": {
      "movement": "Cargo dash catch",
      "entity": "Moving hook carrier",
      "dependency": "The lantern travels on the carrier above a roofed passage while the knight rides below. Taking it during the upward dash preserves the rise needed to reach the sunlit exit."
    },
    "status": "route-proven",
    "author": "Codex",
