  "voices": {
    "outskirts/knight.dontremember": {
      "id": "outskirts/knight.dontremember",
      "path": "voice/outskirts/knight.dontremember.mp3",
      "text": "I don’t remember."
    },
    "outskirts/knight.no": {
      "id": "outskirts/knight.no",
      "path": "voice/outskirts/knight.no.mp3",
      "text": "No."
    },
    "outskirts/knight.walked": {
      "id": "outskirts/knight.walked",
      "path": "voice/outskirts/knight.walked.mp3",
      "text": "I walked."
    },
    "outskirts/mara.ask": {
      "id": "outskirts/mara.ask",
      "path": "voice/outskirts/mara.ask.mp3",
      "text": "Stay flat, you... Oh. Hello. Mara, surveyor. Could I borrow your legs? Three posts between here and the Muster, and I need a bearing off each one. Stand close until the vane swings."
    },
    "outskirts/mara.done": {
      "id": "outskirts/mara.done",
      "path": "voice/outskirts/mara.done.mp3",
      "text": "That’s all three. It reaches the woods. Thank you. Keep the chart; I’ll draw another."
    },
    "outskirts/mara.handover": {
      "id": "outskirts/mara.handover",
      "path": "voice/outskirts/mara.handover.mp3",
      "text": "Keep it out of the rain. I’ve only got the one."
    },
    "outskirts/mara.progress": {
      "id": "outskirts/mara.progress",
      "path": "voice/outskirts/mara.progress.mp3",
      "text": "Still missing some. Ash is by the old camp. Glass is up on the high ledge in Watcher’s Cut. Iron’s at the Muster."
    },
    "outskirts/mara.replay": {
      "id": "outskirts/mara.replay",
      "path": "voice/outskirts/mara.replay.mp3",
      "text": "Everything you’ve walked is drawn in. The blanks are the bits you haven’t."
    },
    "outskirts/olan.back": {
      "id": "outskirts/olan.back",
      "path": "voice/outskirts/olan.back.mp3",
      "text": "You got past the patrols? Hm. Most turn round at the first post."
    },
    "outskirts/olan.first": {
      "id": "outskirts/olan.first",
      "path": "voice/outskirts/olan.first.mp3",
      "text": "Twenty to four. Every blessed day. ...You came from the west? There’s nothing west but the old camp. Patrols turn at the post. Mind them."
    },
    "outskirts/olan.hint": {
      "id": "outskirts/olan.hint",
      "path": "voice/outskirts/olan.hint.mp3",
      "text": "Mara’s after the Glass post? Upper road. Quicker, if heights don’t bother you."
    },
    "outskirts/olan.muster": {
      "id": "outskirts/olan.muster",
      "path": "voice/outskirts/olan.muster.mp3",
      "text": "Soldiers at every post, and I never heard them march in. Did you?"
    },
    "outskirts/olan.reserve": {
      "id": "outskirts/olan.reserve",
      "path": "voice/outskirts/olan.reserve.mp3",
      "text": "Milekeeper left a reserve up above the first stretch of Hollow Mile. Let it go and the road bridges come down. There’s a seal in it, if you can reach it. I can’t, not with these knees."
    },
    "outskirts/olan.slow": {
      "id": "outskirts/olan.slow",
      "path": "voice/outskirts/olan.slow.mp3",
      "text": "Then go slow at the crossing."
    },
    "outskirts/quest.road-without-a-name.active": {
      "id": "outskirts/quest.road-without-a-name.active",
      "path": "voice/outskirts/quest.road-without-a-name.active.mp3",
      "text": "Two records left to compare. The Sky-Well plaque in the Updrafts. The foundation inscription at the Ruined Keep. Copy them down when you’re passing—no special trip."
    },
    "outskirts/quest.road-without-a-name.complete": {
      "id": "outskirts/quest.road-without-a-name.complete",
      "path": "voice/outskirts/quest.road-without-a-name.complete.mp3",
      "text": "Your notes are on the chart. Next person who takes a wagon out that way gets more than we had."
    },
    "outskirts/quest.road-without-a-name.turnIn": {
      "id": "outskirts/quest.road-without-a-name.turnIn",
      "path": "voice/outskirts/quest.road-without-a-name.turnIn.mp3",
      "text": "They match. Same spacing on the plaque as on the Keep’s footings: same builders, same road. That goes on the chart as fact now, not a guess. Thank you."
    },
    "outskirts/rowan.accept": {
      "id": "outskirts/rowan.accept",
      "path": "voice/outskirts/rowan.accept.mp3",
      "text": "Hm. Then walk up that tower and bring the bell down. Cart onto the iron stop first, then pull the brake. Bell comes to the empty post by my bench."
    },
    "outskirts/rowan.after": {
      "id": "outskirts/rowan.after",
      "path": "voice/outskirts/rowan.after.mp3",
      "text": "Bench faces the tents now."
    },
    "outskirts/rowan.long": {
      "id": "outskirts/rowan.long",
      "path": "voice/outskirts/rowan.long.mp3",
      "text": "My brother and I took the evening watch together. He’d moan about the cold, then hand me half his blanket. After he died I kept doing both shifts. Nobody asked me to. Evening came and I didn’t know what else to do with it.\n\nThis is better. I can hear the bell from the bench, and I can see the road."
    },
    "outskirts/rowan.lucky": {
      "id": "outskirts/rowan.lucky",
      "path": "voice/outskirts/rowan.lucky.mp3",
      "text": "Lucky."
    },
    "outskirts/rowan.name": {
      "id": "outskirts/rowan.name",
      "path": "voice/outskirts/rowan.name.mp3",
      "text": "Rowan, by the way. I’m still deciding what to make of you."
    },
    "outskirts/rowan.opening": {
      "id": "outskirts/rowan.opening",
      "path": "voice/outskirts/rowan.opening.mp3",
      "text": "Gate’s shut. Nothing gets through. ...Except you. How?"
    },
    "outskirts/rowan.past": {
      "id": "outskirts/rowan.past",
      "path": "voice/outskirts/rowan.past.mp3",
      "text": "Everyone moved to the camp. I didn’t. Last time I left a post, people died while I was gone. You ever leave one you shouldn’t have?"
    },
    "outskirts/rowan.ready": {
      "id": "outskirts/rowan.ready",
      "path": "voice/outskirts/rowan.ready.mp3",
      "text": "That’ll carry."
    },
    "outskirts/rowan.reward": {
      "id": "outskirts/rowan.reward",
      "path": "voice/outskirts/rowan.reward.mp3",
      "text": "A drake roosted over that bell. Followed it all the way down. It’ll carry you, if you let it."
    },
    "outskirts/rowan.task.ballast": {
      "id": "outskirts/rowan.task.ballast",
      "path": "voice/outskirts/rowan.task.ballast.mp3",
      "text": "Counterweight first. Roll the stone cart onto the iron stop east of here and pull the brake."
    },
    "outskirts/rowan.task.bell": {
      "id": "outskirts/rowan.task.bell",
      "path": "voice/outskirts/rowan.task.bell.mp3",
      "text": "Up the tower ledges. Let the bell go from the top; the pulley brings it down."
    },
    "outskirts/rowan.task.hang": {
      "id": "outskirts/rowan.task.hang",
      "path": "voice/outskirts/rowan.task.hang.mp3",
      "text": "Now bring it back to the empty post by my bench."
    },
    "outskirts/traveler.bark": {
      "id": "outskirts/traveler.bark",
      "path": "voice/outskirts/traveler.bark.mp3",
      "text": "WAIT FOR ME!"
    },
    "outskirts/traveler.greet": {
      "id": "outskirts/traveler.greet",
      "path": "voice/outskirts/traveler.greet.mp3",
      "text": "Oh, hello. Road ahead goes through, I think. Mind if I walk behind you?"
    },
    "outskirts/vey.back": {
      "id": "outskirts/vey.back",
      "path": "voice/outskirts/vey.back.mp3",
      "text": "Back again. Sit, if you like. I won’t ask where you’ve been."
    },
    "outskirts/vey.first": {
      "id": "outskirts/vey.first",
      "path": "voice/outskirts/vey.first.mp3",
      "text": "Nearly... there. Sorry, I’d stand, but I’d regret it. Vey. The fire’s for anyone."
    },
    "outskirts/vey.rowan": {
      "id": "outskirts/vey.rowan",
      "path": "voice/outskirts/vey.rowan.mp3",
      "text": "Rowan’s coming over tonight. Says he’s bringing his own bowl. I’ll pretend that’s a surprise."
    },
    "woods/bram.bark": {
      "id": "woods/bram.bark",
      "path": "voice/woods/bram.bark.mp3",
      "text": "MY LAMP—!"
    },
    "woods/bram.done": {
      "id": "woods/bram.done",
      "path": "voice/woods/bram.done.mp3",
      "text": "Across! I’ll leave her burning on this side, so you can find your way back."
    },
    "woods/bram.first": {
      "id": "woods/bram.first",
      "path": "voice/woods/bram.first.mp3",
      "text": "Easy, easy. Oh! Bram. Sorry. Crossing? Stay where my lamp reaches. Any branch the light shines through isn’t real."
    },
    "woods/bram.repeat": {
      "id": "woods/bram.repeat",
      "path": "voice/woods/bram.repeat.mp3",
      "text": "There, see how it goes straight through that one? Not that one. I’ll wait while you find another."
    },
    "woods/hale.after": {
      "id": "woods/hale.after",
      "path": "voice/woods/hale.after.mp3",
      "text": "Where’d you learn to hold it like that? I’ll sit a while. Shoulder’s not finished complaining."
    },
    "woods/hale.before": {
      "id": "woods/hale.before",
      "path": "voice/woods/hale.before.mp3",
      "text": "Another one for the sword? Roots have it. Vine runs to a counterweight. Hang off that, not the hilt."
    },
    "woods/orra.first": {
      "id": "woods/orra.first",
      "path": "voice/woods/orra.first.mp3",
      "text": "Stopped. Again. Oh, hello. Orra. I’d tell you the time if I had it. If you’re going deeper, look at a branch before you trust it. Some of them aren’t there."
    },
    "woods/orra.moved": {
      "id": "woods/orra.moved",
      "path": "voice/woods/orra.moved.mp3",
      "text": "It moved. One minute since you left. Don’t say anything. It hasn’t done it twice yet."
    },
    "woods/orra.muster": {
      "id": "woods/orra.muster",
      "path": "voice/woods/orra.muster.mp3",
      "text": "Bells started while you were off. Nobody I know is ringing them. If the low road’s crowded, there’s the workers’ reserve above the far end of Briar Run. My daughter used to fetch wraps from it. Let it go and a walkway drops through the canopy."
    },
    "woods/orra.revisit": {
      "id": "woods/orra.revisit",
      "path": "voice/woods/orra.revisit.mp3",
      "text": "Still stopped. I’ve been told never to shake it, so I’ve stopped shaking it. The path back’s clear."
    },
    "woods/pell.first": {
      "id": "woods/pell.first",
      "path": "voice/woods/pell.first.mp3",
      "text": "You’re not resin crew. Here’s the trick, then. Amber on the windward side of a branch, it’s real. Amber on the lee side, don’t jump. You’ll go straight through."
    },
    "woods/pell.revisit": {
      "id": "woods/pell.revisit",
      "path": "voice/woods/pell.revisit.mp3",
      "text": "Worked it out, did you? Took me a nettle patch."
    },
    "woods/quest.inventory-of-effects.active": {
      "id": "woods/quest.inventory-of-effects.active",
      "path": "voice/woods/quest.inventory-of-effects.active.mp3",
      "text": "This list says these things are yours. I’ve never seen you before, which is odd. Three entries are missing: the broken standard past the Woods, the Frost Court’s siphon record, and the Foundry ledger. If you pass them, would you look?"
    },
    "woods/quest.inventory-of-effects.complete": {
      "id": "woods/quest.inventory-of-effects.complete",
      "path": "voice/woods/quest.inventory-of-effects.complete.mp3",
      "text": "All entered, and in order. I’m sorry they were ever scattered."
    },
    "woods/quest.inventory-of-effects.turnIn": {
      "id": "woods/quest.inventory-of-effects.turnIn",
      "path": "voice/woods/quest.inventory-of-effects.turnIn.mp3",
      "text": "That completes it. I hoped the list would feel less familiar once it was finished. It doesn’t. Forgive me, that isn’t your concern."
    },
    "woods/refuge.accept": {
      "id": "woods/refuge.accept",
      "path": "voice/woods/refuge.accept.mp3",
      "text": "Go gently when you catch them. And mind yourself on the way home; take a knock and they’ll have it off you again."
    },
    "woods/refuge.after": {
      "id": "woods/refuge.after",
      "path": "voice/woods/refuge.after.mp3",
      "text": "Still mostly a kitchen."
    },
    "woods/refuge.ending": {
      "id": "woods/refuge.ending",
      "path": "voice/woods/refuge.ending.mp3",
      "text": "Two bowls and a working lamp. That’s supper. Sit before it gets cold."
    },
    "woods/refuge.firstReturn": {
      "id": "woods/refuge.firstReturn",
      "path": "voice/woods/refuge.firstReturn.mp3",
      "text": "Lost a bit of pantry yesterday. I finished cooking from the doorway. The house isn’t what it was. The lantern first; then the step."
    },
    "woods/refuge.longEnding": {
      "id": "woods/refuge.longEnding",
      "path": "voice/woods/refuge.longEnding.mp3",
      "text": "My sister cut the carrots so small you could barely find them. Said it made the soup go further. I cut mine big. If someone’s walked all day, there ought to be something on the spoon.\n\nI know this place needs more than a board and a lamp. But I can mend a little and cook a little while I work out what’s next. There’s another helping if you want it."
    },
    "woods/refuge.opening": {
      "id": "woods/refuge.opening",
      "path": "voice/woods/refuge.opening.mp3",
      "text": "Mind the step, the end’s rotten. Elsie. You look like you’ve walked a long way. The moths took my lantern. They come for the light every evening, and tonight they took the whole thing, off east through the trees. Could you follow them? They never go far at a time."
    },
    "woods/refuge.ready": {
      "id": "woods/refuge.ready",
      "path": "voice/woods/refuge.ready.mp3",
      "text": "Is it too salty? I never remember if I’ve salted it."
    },
    "woods/refuge.rewardLine": {
      "id": "woods/refuge.rewardLine",
      "path": "voice/woods/refuge.rewardLine.mp3",
      "text": "The moths love that lantern now. Hold it up high and they’ll carry you over the trees."
    },
    "woods/refuge.short": {
      "id": "woods/refuge.short",
      "path": "voice/woods/refuge.short.mp3",
      "text": "I’ll bring it back."
    },
    "woods/refuge.task.floor": {
      "id": "woods/refuge.task.floor",
      "path": "voice/woods/refuge.task.floor.mp3",
      "text": "There’s a spare board by the door. Lay it over that step for me."
    },
    "woods/refuge.task.lantern": {
      "id": "woods/refuge.task.lantern",
      "path": "voice/woods/refuge.task.lantern.mp3",
      "text": "Bring her home steady. If you take a knock, the moths will have her back."
    },
    "woods/refuge.task.line": {
      "id": "woods/refuge.task.line",
      "path": "voice/woods/refuge.task.line.mp3",
      "text": "The line’s tied off at the fork, by the wooden peg. Up the branches east of here."
    },
    "woods/refuge.task.log": {
      "id": "woods/refuge.task.log",
      "path": "voice/woods/refuge.task.log.mp3",
      "text": "That step wants a board. Hale cuts wood down the path; he’ll spare one if you help him split that log of his."
    },
    "woods/refuge.task.moths": {
      "id": "woods/refuge.task.moths",
      "path": "voice/woods/refuge.task.moths.mp3",
      "text": "They’ll rest a moment, then go on as you come close. East, through the trees. They tire eventually."
    },
    "woods/refuge.task.table": {
      "id": "woods/refuge.task.table",
      "path": "voice/woods/refuge.task.table.mp3",
      "text": "Now hang her over the table, by the stove."
    },
    "woods/refuge.thanks": {
      "id": "woods/refuge.thanks",
      "path": "voice/woods/refuge.thanks.mp3",
      "text": "It’s good."
    },
    "woods/workshop.ethereal-goods.knight": {
      "id": "woods/workshop.ethereal-goods.knight",
      "path": "voice/woods/workshop.ethereal-goods.knight.mp3",
      "text": "I’ll put it to use."
    },
    "woods/workshop.ethereal-goods.offer": {
      "id": "woods/workshop.ethereal-goods.offer",
      "path": "voice/woods/workshop.ethereal-goods.offer.mp3",
      "text": "I set this fragment aside when I sorted the last delivery. I’d rather it went with someone than sat in my drawer."
    },
    "woods/workshop.ethereal-goods.reply": {
      "id": "woods/workshop.ethereal-goods.reply",
      "path": "voice/woods/workshop.ethereal-goods.reply.mp3",
      "text": "Then it has somewhere to be."
    }
  },
