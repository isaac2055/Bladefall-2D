"retiredRoomDetails": [{
"dialogueMoved": [],
"evidence": "A descending solid staircase with no hazard glyph, enemy or device; the entire saved route is [200, left]. The hint explicitly calls it a breath before the courts. This is the clearest Fractured low-complexity slot, but keep some safe boss preparation rather than filling every breather.",
"grade": "A",
"id": "cl23-fc23-well",
"name": "The Unlit Well",
"to": "cl23-fc23-gantry"
}, {
"dialogueMoved": [],
"evidence": "One rising lift launches to a cracked lip and then a second cracked sill; the main demand is two supers in succession. The first lift/ultra route and Relay Gantry already teach lift momentum and unstable arrival, while Last Gantry is the fuller combination. Preserve vertical/horizontal seam orientation.",
"grade": "B",
"id": "cl23-fc23-rise",
"name": "The Counterweight Rise",
"to": "cl23-fc23-counterpoise"
}, {
"id": "cl23-fc23-middle",
"name": "The Last Count",
"reason": "Replaced by its native boss superroom",
"to": "cl23-bank-f69"
}],
"retiredRooms": {
