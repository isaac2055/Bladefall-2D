  "voices": {
    "cl1-o1-road:vey:line": {
      "text": "Fire’s for anyone. Just don’t touch the white flowers.",
      "id": "ascend/w1-o1-road.vey",
      "seconds": 4.07,
      "name": "Vey",
      "path": "voice/ascend/w1-o1-road.vey.mp3"
    },
    "cl1-o1-verge:mara:line": {
      "text": "Oh! Hello. Mara, surveyor. Three posts off this road: Ash, Glass, Iron. Touch them for me?",
      "id": "ascend/w1-o1-verge.mara",
      "seconds": 6.9,
      "name": "Mara",
      "path": "voice/ascend/w1-o1-verge.mara.mp3"
    },
    "cl1-o1-camp:sentinel:line": {
      "text": "Came up the west road? Huh. Touch the stake on the perch.",
      "id": "ascend/w1-o1-camp.sentinel",
      "seconds": 4.1,
      "name": "Sentinel",
      "path": "voice/ascend/w1-o1-camp.sentinel.mp3"
    },
    "cl1-o1-camp:rowan:line": {
      "text": "Gate’s shut. You got through anyway. Bell’s up the east tower.",
      "id": "ascend/w1-o1-camp.rowan",
      "seconds": 4.38,
      "name": "Rowan",
      "path": "voice/ascend/w1-o1-camp.rowan.mp3"
    },
    "cl1-o1-camp:rowan:lineDone": {
      "text": "There. Now we’ll hear them coming.",
      "id": "ascend/w1-o1-camp.rowan.done",
      "seconds": 2.71,
      "name": "Rowan",
      "path": "voice/ascend/w1-o1-camp.rowan.done.mp3"
    },
    "cl1-o1-cut:olan:line": {
      "text": "Clock’s stopped. The cut’s worse. Only the glass in the air holds.",
      "id": "ascend/w1-o1-cut.olan",
      "seconds": 4.77,
      "name": "Olan",
      "path": "voice/ascend/w1-o1-cut.olan.mp3"
    },
    "cl1-o1-muster:mara:line": {
      "text": "Made it. Any bearings for me?",
      "id": "ascend/w1-o1-muster.mara",
      "seconds": 2.12,
      "name": "Mara",
      "path": "voice/ascend/w1-o1-muster.mara.mp3"
    },
    "cl1-o1-muster:mara:lineDone": {
      "text": "Ash, Glass, Iron. They agree. The road goes through.",
      "id": "ascend/w1-o1-muster.mara.done",
      "seconds": 4.07,
      "name": "Mara",
      "path": "voice/ascend/w1-o1-muster.mara.done.mp3"
    },
    "cl2-w2-refuge:orra:line": {
      "text": "Stopped again. Don’t ask me the time.",
      "id": "ascend/w2-w2-refuge.orra",
      "seconds": 3.14,
      "name": "Orra",
      "path": "voice/ascend/w2-w2-refuge.orra.mp3"
    },
    "cl2-w2-refuge:pell:line": {
      "text": "Not resin crew, are you? A cut pod kicks. Get a blade.",
      "id": "ascend/w2-w2-refuge.pell",
      "seconds": 4.26,
      "name": "Pell",
      "path": "voice/ascend/w2-w2-refuge.pell.mp3"
    },
    "cl2-w2-refuge:mara:line": {
      "text": "You again. The tunnel comes up right here. Refuge is ahead.",
      "id": "ascend/w2-w2-refuge.mara",
      "seconds": 3.97,
      "name": "Mara",
      "path": "voice/ascend/w2-w2-refuge.mara.mp3"
    },
    "cl2-w2-clearing:hale:line": {
      "text": "Sword was in those roots. Cost me a shoulder. Take it.",
      "id": "ascend/w2-w2-clearing.hale",
      "seconds": 4.6,
      "name": "Hale",
      "path": "voice/ascend/w2-w2-clearing.hale.mp3"
    },
    "cl2-w2-kitchen:elsie:line": {
      "text": "Mind the step. Elsie. My lantern’s stuck up in the branches. Fetch it?",
      "id": "ascend/w2-w2-kitchen.elsie",
      "seconds": 5.23,
      "name": "Elsie",
      "path": "voice/ascend/w2-w2-kitchen.elsie.mp3"
    },
    "cl2-w2-kitchen:elsie:lineDone": {
      "text": "Lamp’s lit. Two bowls. Sit.",
      "id": "ascend/w2-w2-kitchen.elsie.done",
      "seconds": 2.92,
      "name": "Elsie",
      "path": "voice/ascend/w2-w2-kitchen.elsie.done.mp3"
    },
    "cl2-w2-edge:bram:line": {
      "text": "Easy, easy… Bram. Light goes through a branch? It isn’t there.",
      "id": "ascend/w2-w2-edge.bram",
      "seconds": 5.21,
      "name": "Bram",
      "path": "voice/ascend/w2-w2-edge.bram.mp3"
    },
    "cl3-c3-camp:sable:line": {
      "text": "Not one of the yard’s, are you? Nothing up there’s moved in a month.",
      "id": "ascend/w3-c3-camp.sable",
      "seconds": 3.92,
      "name": "Sable",
      "path": "voice/ascend/w3-c3-camp.sable.mp3"
    },
    "cl3-c3-camp:oren:line": {
      "text": "Hear that? Nothing. The Drop Yard lift is free. Stand on it.",
      "id": "ascend/w3-c3-camp.oren",
      "seconds": 4.22,
      "name": "Oren",
      "path": "voice/ascend/w3-c3-camp.oren.mp3"
    },
    "cl3-c3-hoist:oren:line": {
      "text": "She comes back down on her own. Ride her up.",
      "id": "ascend/w3-c3-hoist.oren",
      "seconds": 2.69,
      "name": "Oren",
      "path": "voice/ascend/w3-c3-hoist.oren.mp3"
    },
    "cl3-c3-patrol:silas:line": {
      "text": "…thirty-nine, forty. Can’t stop. Break the gear up the ladder?",
      "id": "ascend/w3-c3-patrol.silas",
      "seconds": 5.49,
      "name": "Silas",
      "path": "voice/ascend/w3-c3-patrol.silas.mp3"
    },
    "cl3-c3-patrol:silas:lineDone": {
      "text": "Forty-one. Then I sat. My choice.",
      "id": "ascend/w3-c3-patrol.silas.done",
      "seconds": 4.81,
      "name": "Silas",
      "path": "voice/ascend/w3-c3-patrol.silas.done.mp3"
    },
    "cl21-fo21-map:mara:line": {
      "text": "Your chart still has a road here. Mine stopped.",
      "id": "ascend/w21-fo21-map.mara",
      "seconds": 3.08,
      "name": "MARA’S ECHO",
      "path": "voice/ascend/w21-fo21-map.mara.mp3"
    },
    "cl21-fo21-map:mara:lineDone": {
      "text": "There it is. A way through the blank.",
      "id": "ascend/w21-fo21-map.mara.done",
      "seconds": 2.38,
      "name": "MARA’S ECHO",
      "path": "voice/ascend/w21-fo21-map.mara.done.mp3"
    },
    "cl21-fo21-camp:rowan:line": {
      "text": "The bell is behind you. It always was.",
      "id": "ascend/w21-fo21-camp.rowan",
      "seconds": 3.1,
      "name": "ROWAN’S ECHO",
      "path": "voice/ascend/w21-fo21-camp.rowan.mp3"
    },
    "cl21-fo21-camp:rowan:lineDone": {
      "text": "Someone answered. I can leave it ringing.",
      "id": "ascend/w21-fo21-camp.rowan.done",
      "seconds": 2.84,
      "name": "ROWAN’S ECHO",
      "path": "voice/ascend/w21-fo21-camp.rowan.done.mp3"
    },
    "cl21-fo21-q-chart:mara:line": {
      "text": "I drew the way out. Keep the part that still leads somewhere.",
      "id": "ascend/w21-fo21-q-chart.mara",
      "seconds": 3.4,
      "name": "MARA’S ECHO",
      "path": "voice/ascend/w21-fo21-q-chart.mara.mp3"
    },
    "cl21-fo21-q-chart:mara:lineDone": {
      "text": "The blank has an edge now.",
      "id": "ascend/w21-fo21-q-chart.mara.done",
      "seconds": 1.79,
      "name": "MARA’S ECHO",
      "path": "voice/ascend/w21-fo21-q-chart.mara.done.mp3"
    },
    "cl21-fo21-q-bell:rowan:line": {
      "text": "I heard it. That was enough.",
      "id": "ascend/w21-fo21-q-bell.rowan",
      "seconds": 2.29,
      "name": "ROWAN’S ECHO",
      "path": "voice/ascend/w21-fo21-q-bell.rowan.mp3"
    },
    "cl21-fo21-q-bell:rowan:lineDone": {
      "text": "You heard it too.",
      "id": "ascend/w21-fo21-q-bell.rowan.done",
      "seconds": 1.54,
      "name": "ROWAN’S ECHO",
      "path": "voice/ascend/w21-fo21-q-bell.rowan.done.mp3"
    },
    "cl22-fw22-kitchen:elsie:line": {
      "text": "I left a bowl out. Habit, I suppose.",
      "id": "ascend/w22-fw22-kitchen.elsie",
      "seconds": 3.21,
      "name": "ELSIE’S ECHO",
      "path": "voice/ascend/w22-fw22-kitchen.elsie.mp3"
    },
    "cl22-fw22-kitchen:elsie:lineDone": {
      "text": "Still warm. Don’t ask me how.",
      "id": "ascend/w22-fw22-kitchen.elsie.done",
      "seconds": 2.97,
      "name": "ELSIE’S ECHO",
      "path": "voice/ascend/w22-fw22-kitchen.elsie.done.mp3"
    },
    "cl22-fw22-q-lantern:elsie:line": {
      "text": "I knew you’d find the table.",
      "id": "ascend/w22-fw22-q-lantern.elsie",
      "seconds": 2.23,
      "name": "ELSIE’S ECHO",
      "path": "voice/ascend/w22-fw22-q-lantern.elsie.mp3"
    },
    "cl22-fw22-q-lantern:elsie:lineDone": {
      "text": "You never did like eating alone.",
      "id": "ascend/w22-fw22-q-lantern.elsie.done",
      "seconds": 2.37,
      "name": "ELSIE’S ECHO",
      "path": "voice/ascend/w22-fw22-q-lantern.elsie.done.mp3"
    },
    "cl23-fc23-silas:silas:line": {
      "text": "Forty paces. I remember the forty-first better.",
      "id": "ascend/w23-fc23-silas.silas",
      "seconds": 4.43,
      "name": "SILAS’S ECHO",
      "path": "voice/ascend/w23-fc23-silas.silas.mp3"
    },
    "cl23-fc23-silas:silas:lineDone": {
      "text": "I chose that step. That part still belongs to me.",
      "id": "ascend/w23-fc23-silas.silas.done",
      "seconds": 4.36,
      "name": "SILAS’S ECHO",
      "path": "voice/ascend/w23-fc23-silas.silas.done.mp3"
    },
    "cl23-fc23-q-governor:silas:line": {
      "text": "There was a bench beyond the turning point. I never knew.",
      "id": "ascend/w23-fc23-q-governor.silas",
      "seconds": 4.24,
      "name": "SILAS’S ECHO",
      "path": "voice/ascend/w23-fc23-q-governor.silas.mp3"
    },
    "cl23-fc23-q-governor:silas:lineDone": {
      "text": "I sat there because I wanted to.",
      "id": "ascend/w23-fc23-q-governor.silas.done",
      "seconds": 2.86,
      "name": "SILAS’S ECHO",
      "path": "voice/ascend/w23-fc23-q-governor.silas.done.mp3"
    },
    "refuge:line0": {
      "text": "The moths took my lantern, off into the trees past the kitchen. They never go far at a time. Could you follow them?",
      "id": "ascend/errands.refuge.0",
      "seconds": 7.52,
      "name": "Elsie",
      "path": "voice/ascend/errands.refuge.0.mp3"
    },
    "refuge:line1": {
      "text": "Bring her home steady. If you fall, the moths will have her back.",
      "id": "ascend/errands.refuge.1",
      "seconds": 4.64,
      "name": "Elsie",
      "path": "voice/ascend/errands.refuge.1.mp3"
    },
    "refuge:done": {
      "text": "Two bowls and a working lamp. That’s supper. Sit before it gets cold.",
      "id": "woods/refuge.ending",
      "seconds": 4.67,
      "name": "Elsie",
      "path": "voice/woods/refuge.ending.mp3"
    },
    "defector:line0": {
      "text": "Thirty-nine, forty. The governor at the top of the ladder turns me. Strike its bright tooth; anything else and you only bruise your arm.",
      "id": "ascend/errands.defector.0",
      "seconds": 11.04,
      "name": "Silas",
      "path": "voice/ascend/errands.defector.0.mp3"
    },
    "defector:line1": {
      "text": "Take the key from my back, would you? Hang it on the toll hook, at the top of the next climb. Where nobody can wind me.",
      "id": "ascend/errands.defector.1",
      "seconds": 7.84,
      "name": "Silas",
      "path": "voice/ascend/errands.defector.1.mp3"
    },
    "defector:done": {
      "text": "Forty-one. Forty-two. I’ve lost count. Good.",
      "id": "causeway/defector.ready",
      "seconds": 4.8,
      "name": "Silas",
      "path": "voice/causeway/defector.ready.mp3"
    }
  },
  "unvoiced": [
    {
      "key": "cl1-passage-1-2:orra:line",
      "text": "The Keep’s water finds its way down here. Follow the pale roots; they drink from the same river."
    }
  ],
