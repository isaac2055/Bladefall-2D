  "voices": {
    "cl1-o1-road:vey:line": {
      "text": "Fire’s for anyone. Just don’t touch the white flowers.",
      "id": "ascend/w1-o1-road.vey",
      "seconds": 4.07,
      "name": "Vey",
      "path": "voice/ascend/w1-o1-road.vey.mp3"
    },
    "cl1-o1-verge:mara:line": {
      "text": "Oh! Hello. Mara, surveyor. Three posts off this road: Ash, Glass, Iron. Touch them for me?",
      "id": "ascend/w1-o1-verge.mara",
      "seconds": 6.9,
      "name": "Mara",
      "path": "voice/ascend/w1-o1-verge.mara.mp3"
    },
    "cl1-o1-camp:sentinel:line": {
      "text": "Came up the west road? Huh. Touch the stake on the perch.",
      "id": "ascend/w1-o1-camp.sentinel",
      "seconds": 4.1,
      "name": "Sentinel",
      "path": "voice/ascend/w1-o1-camp.sentinel.mp3"
    },
    "cl1-o1-camp:rowan:line": {
      "text": "Gate’s shut. You got through anyway. Bell’s up the east tower.",
      "id": "ascend/w1-o1-camp.rowan",
      "seconds": 4.38,
      "name": "Rowan",
      "path": "voice/ascend/w1-o1-camp.rowan.mp3"
    },
    "cl1-o1-camp:rowan:lineDone": {
      "text": "There. Now we’ll hear them coming.",
      "id": "ascend/w1-o1-camp.rowan.done",
      "seconds": 2.71,
      "name": "Rowan",
      "path": "voice/ascend/w1-o1-camp.rowan.done.mp3"
    },
    "cl1-o1-cut:olan:line": {
      "text": "Clock’s stopped. The cut’s worse. Only the glass in the air holds.",
      "id": "ascend/w1-o1-cut.olan",
      "seconds": 4.77,
      "name": "Olan",
      "path": "voice/ascend/w1-o1-cut.olan.mp3"
    },
    "cl1-o1-muster:mara:line": {
      "text": "Made it. Any bearings for me?",
      "id": "ascend/w1-o1-muster.mara",
      "seconds": 2.12,
      "name": "Mara",
      "path": "voice/ascend/w1-o1-muster.mara.mp3"
    },
    "cl1-o1-muster:mara:lineDone": {
      "text": "Ash, Glass, Iron. They agree. The road goes through.",
      "id": "ascend/w1-o1-muster.mara.done",
      "seconds": 4.07,
      "name": "Mara",
      "path": "voice/ascend/w1-o1-muster.mara.done.mp3"
    },
    "cl2-w2-refuge:orra:line": {
      "text": "Stopped again. Don’t ask me the time.",
      "id": "ascend/w2-w2-refuge.orra",
      "seconds": 3.14,
      "name": "Orra",
      "path": "voice/ascend/w2-w2-refuge.orra.mp3"
    },
    "cl2-w2-refuge:pell:line": {
      "text": "Not resin crew, are you? A cut pod kicks. Get a blade.",
      "id": "ascend/w2-w2-refuge.pell",
      "seconds": 4.26,
      "name": "Pell",
      "path": "voice/ascend/w2-w2-refuge.pell.mp3"
    },
    "cl2-w2-refuge:mara:line": {
      "text": "You again. The tunnel comes up right here. Refuge is ahead.",
      "id": "ascend/w2-w2-refuge.mara",
      "seconds": 3.97,
      "name": "Mara",
      "path": "voice/ascend/w2-w2-refuge.mara.mp3"
    },
    "cl2-w2-clearing:hale:line": {
      "text": "Sword was in those roots. Cost me a shoulder. Take it.",
      "id": "ascend/w2-w2-clearing.hale",
      "seconds": 4.6,
      "name": "Hale",
      "path": "voice/ascend/w2-w2-clearing.hale.mp3"
    },
    "cl2-w2-kitchen:elsie:line": {
      "text": "Mind the step. Elsie. My lantern’s stuck up in the branches. Fetch it?",
      "id": "ascend/w2-w2-kitchen.elsie",
      "seconds": 5.23,
      "name": "Elsie",
      "path": "voice/ascend/w2-w2-kitchen.elsie.mp3"
    },
    "cl2-w2-kitchen:elsie:lineDone": {
      "text": "Lamp’s lit. Two bowls. Sit.",
      "id": "ascend/w2-w2-kitchen.elsie.done",
      "seconds": 2.92,
      "name": "Elsie",
      "path": "voice/ascend/w2-w2-kitchen.elsie.done.mp3"
    },
    "cl2-w2-edge:bram:line": {
      "text": "Easy, easy… Bram. Light goes through a branch? It isn’t there.",
      "id": "ascend/w2-w2-edge.bram",
      "seconds": 5.21,
      "name": "Bram",
      "path": "voice/ascend/w2-w2-edge.bram.mp3"
    },
    "refuge:line0": {
      "text": "The moths took my lantern, off into the trees past the kitchen. They never go far at a time. Could you follow them?",
      "id": "ascend/errands.refuge.0",
      "seconds": 7.52,
      "name": "Elsie",
      "path": "voice/ascend/errands.refuge.0.mp3"
    },
    "refuge:line1": {
      "text": "Bring her home steady. If you fall, the moths will have her back.",
      "id": "ascend/errands.refuge.1",
      "seconds": 4.64,
      "name": "Elsie",
      "path": "voice/ascend/errands.refuge.1.mp3"
    },
    "refuge:done": {
      "text": "Two bowls and a working lamp. That’s supper. Sit before it gets cold.",
      "id": "woods/refuge.ending",
      "seconds": 4.67,
      "name": "Elsie",
      "path": "voice/woods/refuge.ending.mp3"
    }
  },
  "unvoiced": [
    {
      "key": "cl1-passage-1-2:orra:line",
      "text": "The Keep’s water finds its way down here. Follow the pale roots; they drink from the same river."
    }
  ],
