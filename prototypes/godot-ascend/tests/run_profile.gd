extends SceneTree
const Profile=preload("res://scripts/run_profile.gd")
var failures=0
func check(ok,label):
 print("PASS " if ok else "FAIL ",label)
 if not ok: failures+=1
func _initialize():
 var path="user://profile-test-%d.json"%Time.get_ticks_usec()
 var p=Profile.new(path)
 p.start(1)
 p.tick("start")
 check(p.finish(["end"]).is_empty(),"cannot finish before required route")
 p.tick("end")
 check(not p.finish(["end"]).is_empty() and p.garden(1).root,"base perfect earns root")
 check(p.finish().is_empty() and p.board(1).size()==1,"finish is idempotent")
 p.completed["2"]=true;p.completed["3"]=true
 p.start(21)
 p.tick("end",3)
 p.finish()
 check(not p.core_open(1) and not p.garden(1).flower_shiny,"one Fractured clear does not unlock Core")
 p.completed["22"]=true;p.completed["23"]=true
 check(p.core_open(1),"all three Fractured clears unlock Core")
 p.start(101)
 p.tick("end",5)
 p.finish()
 check(p.garden(1).core and not p.garden(1).core_shiny,"Core deaths allowed, animated reward owned")
 p.start(21,true,true)
 p.tick("end")
 p.finish()
 check(p.garden(1).flower_shiny and p.board(21,"shiny").size()==1,"carried perfect Fractured earns shiny")
 p.start(101,true,true)
 p.tick("end")
 p.finish()
 check(p.garden(1).core_shiny,"carried perfect Core earns shiny")
 p.start(2)
 p.tick("end",1)
 p.finish()
 check(p.garden(2).root and not p.garden(2).root_shiny,"base death grants plain root")
 p.start(22)
 p.invalidate()
 p.tick("end")
 check(p.finish().is_empty() and p.board(22).is_empty(),"practice earns no reward or record")
 var q=Profile.new(path)
 check(q.garden(1).core_shiny and q.board(21).size()==1,"garden and boards survive reload")
 check(Profile.duration(3601)=="01:00.01","time uses active physics frames")
 DirAccess.remove_absolute(ProjectSettings.globalize_path(path))
 quit(1 if failures else 0)
