  fists:{disp:'Fists',cls:'melee',sch:'phys',dmg:3,cd:.20,kb:60,range:30,reach:15,art:'none'},
};
const ARCHIDS=Object.keys(ARCH);
// Droppable weapons: never the starter sword, never the bare-fists fallback.
const LOOTIDS=ARCHIDS.filter(a=>a!=='sword'&&a!=='fists');
function randLootArch(){return LOOTIDS[Math.floor(Math.random()*LOOTIDS.length)];}
function makeWeapon(aid,rid,nameO){const a=ARCH[aid],r=RARITY[rid];const w={arche:aid,art:a.art,cls:a.cls,sch:a.sch,el:a.el||null,rarity:rid,name:nameO||(r.name+' '+a.disp),dmg:+(a.dmg*r.mul).toFixed(1),cd:a.cd,kb:a.kb,crit:0.10,lifesteal:(a.lifesteal||0)+(rid==='legendary'?0.03:0),color:r.color,blade:(a.sch==='mag'?(elColor(a.el)||'#c9a6ff'):'#dfe5ec')};if(a.cls==='melee'){w.range=a.range;w.reach=a.reach;w.maxDur=Math.round(120*r.mul);w.dur=w.maxDur;}else{w.proj=Object.assign({},a.proj);w.maxAmmo=Math.round(60*r.mul);w.ammo=w.maxAmmo;}if(aid==='fists'){w.dur=Infinity;w.maxDur=Infinity;}return w;}
function startWeapon(){const w=makeWeapon('sword','common','Rusty Sword');w.dmg=9;w.blade='#bcae8a';return w;}

/* Armor */
const SLOTS={helmet:{label:'Helmet',def:[6,10,15,21,28]},chest:{label:'Chestplate',def:[9,15,22,30,40]},legs:{label:'Leggings',def:[7,11,17,23,31]}};
const SLOTIDS=['helmet','chest','legs'];
function makeArmor(rid,slot){const r=RARITY[rid],tier=r.tier,sl=SLOTS[slot];
  const pool=[{stat:'hp',base:[10,16,22,30,40],f:v=>'+'+v+' Max HP'},{stat:'speedMul',base:[.04,.05,.07,.09,.11],f:v=>'+'+Math.round(v*100)+'% Speed'},{stat:'atkSpeedMul',base:[.03,.05,.06,.08,.10],f:v=>'+'+Math.round(v*100)+'% Atk Spd'},{stat:'lifesteal',base:[.01,.015,.02,.025,.035],f:v=>'+'+Math.round(v*100)+'% Lifesteal'},{stat:'dodgeMul',base:[.05,.07,.09,.11,.14],f:v=>'-'+Math.round(v*100)+'% Dodge CD'},{stat:'powerMul',base:[.04,.05,.07,.09,.11],f:v=>'+'+Math.round(v*100)+'% Damage'}];
  const n=tier>=3?2:1,chosen=[],p2=[...pool];for(let i=0;i<n;i++){const a=p2.splice(Math.floor(Math.random()*p2.length),1)[0];chosen.push({stat:a.stat,val:a.base[tier],label:a.f(a.base[tier])});}
  return{slot,rarity:rid,defense:sl.def[tier],color:r.color,name:r.name+' '+sl.label,affixes:chosen};
}

