<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0,maximum-scale=1.0,user-scalable=no,viewport-fit=cover">
<title>BLADEFALL</title>
<meta name="theme-color" content="#0b0c10">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="BLADEFALL">
<link rel="apple-touch-icon" href="apple-touch-icon.png">
<link rel="icon" href="icon.svg">
<link rel="manifest" href="manifest.webmanifest">
<style>
:root{--bg:#0b0c10;--ink:#f3f1ea;--muted:#8b8f9a;--amber:#e8a33d;--amber-dim:#5a4422;--hp:#e8453d;--xp:#3a9dd0;--good:#3ad07f;--danger:#ff5e54;--panel:#15161c;--line:#2a2c36;--sat:env(safe-area-inset-top,0px);--sar:env(safe-area-inset-right,0px);--sab:env(safe-area-inset-bottom,0px);}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;-webkit-user-select:none;user-select:none;}
html,body{margin:0;padding:0;height:100%;overflow:hidden;background:var(--bg);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;touch-action:none;overscroll-behavior:none;position:fixed;width:100%;}
#gameContainer{position:absolute;inset:0;width:100%;height:100%;}
#hud{position:absolute;left:0;right:0;top:0;padding:8px 12px 0;pointer-events:none;z-index:5;}
#hud.hide{display:none;}
.barwrap{display:flex;align-items:center;gap:8px;margin-bottom:5px;}
.barlabel{font-size:10px;font-weight:800;letter-spacing:.12em;width:26px;color:var(--muted);}
.bar{flex:1;height:12px;background:#0006;border:1px solid var(--line);border-radius:8px;overflow:hidden;}
.bar>i{display:block;height:100%;width:0;border-radius:8px;transition:width .12s linear;}
#hpFill{background:linear-gradient(90deg,#ff6a60,var(--hp));}
#xpFill{background:linear-gradient(90deg,#56b6e6,var(--xp));}
#hud .meta{display:flex;justify-content:space-between;align-items:center;margin-top:2px;}
#hud .left{display:flex;align-items:center;gap:9px;flex-wrap:wrap;}
#lvlBadge{font-size:11px;font-weight:800;letter-spacing:.06em;color:var(--amber);background:var(--amber-dim);padding:3px 8px;border-radius:999px;}
#weaponTag{font-size:11px;font-weight:700;color:var(--ink);opacity:.95;}
#armorTag{font-size:11px;font-weight:700;color:#aeb9c6;display:flex;align-items:center;gap:4px;}
#armorTag .pip{width:7px;height:7px;border-radius:2px;display:inline-block;background:#333;}
#stageTag{font-size:10px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);}
#bosshpwrap{position:absolute;left:50%;top:64px;transform:translateX(-50%);width:min(560px,86vw);display:none;z-index:5;pointer-events:none;}
#bosshpwrap.on{display:block;}
#bossname{text-align:center;font-size:11px;font-weight:800;letter-spacing:.22em;text-transform:uppercase;color:var(--danger);margin-bottom:4px;text-shadow:0 1px 4px #000;}
#bosshp{height:10px;background:#0008;border:1px solid #6b1c18;border-radius:6px;overflow:hidden;}
#bosshp>i{display:block;height:100%;width:100%;background:linear-gradient(90deg,#ff7a52,#c9281f);}
.barwrap.map{margin-bottom:2px;}
.barwrap.map .barlabel{font-size:8.5px;}
.barwrap.map .bar{height:5px;}
#progFill{background:#8b8f9a;}
#controls{position:absolute;left:0;right:0;bottom:0;height:100%;pointer-events:none;z-index:6;}
#controls.hide{display:none;}
/* On a mouse/PC (a fine pointer that can hover) the on-screen joystick and
   action buttons are just clutter — play with the keyboard. Only touch devices
   (pointer:coarse) show them. */
@media (hover:hover) and (pointer:fine){#controls{display:none!important;}}
.btn{position:absolute;pointer-events:auto;touch-action:none;display:flex;align-items:center;justify-content:center;border-radius:50%;background:rgba(28,30,38,.26);border:1.5px solid rgba(255,255,255,.22);color:#fff;font-weight:800;backdrop-filter:blur(2px);-webkit-backdrop-filter:blur(2px);font-size:13px;letter-spacing:.04em;text-shadow:0 1px 3px rgba(0,0,0,.6);transition:transform .05s,background .08s;}
.btn.pressed{background:rgba(232,163,61,.55);border-color:#f3c272;transform:scale(.94);}
.btn svg{width:46%;height:46%;fill:currentColor;}
#joyzone{position:absolute;left:0;bottom:0;width:46%;height:46%;pointer-events:auto;}
#joy{position:absolute;width:104px;height:104px;border-radius:50%;background:rgba(28,30,38,.35);border:1.5px solid rgba(255,255,255,.12);display:none;pointer-events:none;}
#joyknob{position:absolute;width:46px;height:46px;border-radius:50%;background:rgba(232,163,61,.5);border:1.5px solid #f3c272;left:29px;top:29px;pointer-events:none;}
#bAttack{width:96px;height:96px;right:16px;bottom:16px;font-size:16px;background:rgba(232,69,61,.26);border-color:rgba(255,140,134,.45);}
#bAttack.pressed{background:rgba(232,69,61,.55);}
#bAttack.ranged{background:rgba(120,90,210,.26);border-color:rgba(170,150,240,.5);}
#bAttack.ranged.pressed{background:rgba(120,90,210,.55);}
#bJump{width:80px;height:80px;right:24px;bottom:124px;}
#bDodge{width:78px;height:78px;right:124px;bottom:16px;font-size:12px;background:rgba(58,157,208,.24);border-color:rgba(120,200,235,.45);}
#bDodge.pressed{background:rgba(58,157,208,.55);}
#bDodge.cooling{opacity:.4;}
#bFlip{width:60px;height:60px;right:130px;bottom:108px;font-size:18px;background:rgba(176,107,255,.24);border-color:rgba(196,123,255,.55);display:none;}
#bFlip.on{display:flex;}
#bFlip.pressed{background:rgba(176,107,255,.55);}
#bPortal{width:60px;height:60px;right:214px;bottom:60px;font-size:22px;background:rgba(79,195,255,.24);border-color:rgba(140,215,255,.5);}
#bPortal.pressed{background:rgba(79,195,255,.6);}
#bCommand{width:60px;height:60px;right:290px;bottom:60px;font-size:11px;background:rgba(159,232,220,.2);border-color:rgba(159,232,220,.55);display:none;}
#bCommand.on{display:flex;}
#bCommand.pressed{background:rgba(159,232,220,.55);}
#fuelTag{font-size:11px;font-weight:800;color:#e8a33d;}
#flipTag{font-size:11px;font-weight:800;color:#c47bff;}
#portalTag{font-size:11px;font-weight:800;color:#8fdcff;}
#companionTag{font-size:11px;font-weight:800;color:#9fe8dc;}
#pausebtn{position:absolute;top:8px;right:12px;z-index:7;width:34px;height:34px;border-radius:9px;background:rgba(28,30,38,.5);border:1px solid var(--line);color:var(--ink);font-size:13px;display:flex;align-items:center;justify-content:center;pointer-events:auto;}
#pausebtn.hide{display:none;}
#rotateHint{display:none;position:fixed;inset:0;z-index:9999;background:var(--bg);color:var(--ink);flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:24px;gap:14px;}
#rotateHint svg{width:64px;height:64px;color:var(--amber);animation:rotateHintSpin 1.8s ease-in-out infinite;}
@keyframes rotateHintSpin{0%,20%{transform:rotate(0deg);}45%,55%{transform:rotate(-90deg);}80%,100%{transform:rotate(-90deg);}}
@media (orientation:portrait) and (pointer:coarse){body:not(.portraitDismissed) #rotateHint{display:flex;}}
#overlay{position:absolute;inset:0;z-index:20;display:flex;align-items:center;justify-content:center;padding:24px;background:rgba(6,7,10,.82);backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px);text-align:center;overflow:hidden;touch-action:none;}
#overlay.hide{display:none;}
/* The card is bounded to the viewport and scrolls internally, so nothing (e.g.
   the Settings toggles / Back button) is ever clipped off-screen; the delegated
   handler in the head drives its scrollTop from wheel/touch. */
.card{width:100%;max-width:380px;max-height:calc(100vh - 36px);overflow-y:auto;overscroll-behavior:contain;touch-action:none;}
.title{font-size:clamp(34px,11vw,52px);font-weight:900;letter-spacing:.04em;margin:0;background:linear-gradient(180deg,#f7d79a,var(--amber));-webkit-background-clip:text;background-clip:text;color:transparent;text-shadow:0 4px 24px rgba(232,163,61,.25);}
.subtitle{color:var(--muted);font-size:13px;letter-spacing:.22em;text-transform:uppercase;margin:6px 0 22px;}
.bigbtn{display:block;width:100%;padding:15px;margin:9px 0;border:none;border-radius:14px;font-size:16px;font-weight:800;letter-spacing:.02em;cursor:pointer;color:#0b0c10;background:var(--amber);touch-action:none;}
.bigbtn.ghost{background:transparent;color:var(--ink);border:1.5px solid var(--line);}
.bigbtn:active{transform:scale(.98);}
.ovh{font-size:24px;font-weight:900;margin:0 0 4px;letter-spacing:.02em;}
.ovsub{color:var(--muted);font-size:14px;margin:0 0 20px;line-height:1.5;}
.choices{display:flex;flex-direction:column;gap:12px;overscroll-behavior:contain;-webkit-overflow-scrolling:touch;touch-action:none;}
.choice{padding:14px 16px;border-radius:14px;background:var(--panel);border:1.5px solid var(--line);cursor:pointer;text-align:left;transition:border-color .1s,transform .05s;touch-action:none;}
.choice:active{transform:scale(.985);}
.choice .cname{font-size:16px;font-weight:800;color:var(--amber);display:flex;align-items:center;gap:8px;}
.choice .cdesc{font-size:13px;color:var(--muted);margin-top:3px;line-height:1.4;}
.choice .ckey{margin-left:auto;font-size:11px;font-weight:800;color:var(--muted);border:1px solid var(--muted);border-radius:4px;padding:1px 7px;opacity:.8;}
#cutscene{position:absolute;inset:0;z-index:999;background:#06070a;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:24px;text-align:center;color:#fff;font-family:-apple-system,sans-serif;transition:opacity 1s;pointer-events:auto;}
#cutscene.hide{display:none;}
#cutText{font-size:clamp(16px,4vw,22px);line-height:1.6;max-width:500px;font-style:italic;color:var(--muted);transition:opacity 0.8s;opacity:0;}
#cutscene.fadein #cutText{opacity:1;}
#cutSkip{position:absolute;bottom:20px;left:50%;transform:translateX(-50%);color:var(--muted);font-size:14px;cursor:pointer;opacity:0.6;padding:10px;z-index:2;touch-action:manipulation;}
.statgrid{text-align:left;background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:14px 16px;margin:0 0 20px;}
.hint{font-size:11px;color:var(--muted);margin-top:14px;line-height:1.6;}
.vsrow{display:flex;justify-content:space-between;gap:6px;font-size:12px;color:var(--muted);margin:3px 0;}
.vsrow b{color:var(--ink);}
.up{color:var(--good);}.down{color:var(--danger);}
.volrow{display:flex;align-items:center;gap:10px;margin:2px 0 4px;}
.volrow input[type=range]{flex:1;accent-color:var(--amber);height:20px;}
.kblist{display:flex;flex-direction:column;gap:6px;margin-bottom:14px;}
.kbrow{display:flex;align-items:center;justify-content:space-between;gap:10px;background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:8px 10px;}
.kbname{font-size:13px;color:var(--ink);}
.kbkey{min-width:64px;padding:6px 10px;border-radius:8px;background:var(--bg);border:1.5px solid var(--line);color:var(--amber);font-weight:800;font-size:12px;cursor:pointer;touch-action:none;}
.kbkey.listening{border-color:var(--amber);color:var(--ink);background:var(--amber-dim);}
#toast{position:absolute;left:50%;top:30%;transform:translateX(-50%);z-index:25;background:rgba(20,21,27,.92);border:1px solid var(--amber-dim);color:var(--amber);font-weight:800;font-size:13px;letter-spacing:.04em;padding:10px 18px;border-radius:12px;opacity:0;transition:opacity .2s,top .2s;pointer-events:none;text-align:center;max-width:80vw;}
#toast.show{opacity:1;top:24%;}
</style>
</head>
<body>
<div id="gameContainer"></div>
<div id="rotateHint">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="5" y="2" width="14" height="20" rx="2.5"/><path d="M9 20h6"/></svg>
  <div style="font-size:18px;font-weight:700;">Turn your phone sideways</div>
  <div style="font-size:13px;color:var(--muted);max-width:260px;">Bladefall plays best in landscape — the controls and camera need the room.</div>
  <div id="rotateDismiss" style="margin-top:6px;font-size:12px;color:var(--muted);text-decoration:underline;opacity:.7;">Continue in portrait</div>
</div>
<div id="hud" class="hide">
  <div class="barwrap"><span class="barlabel">HP</span><div class="bar"><i id="hpFill"></i></div></div>
  <div class="barwrap"><span class="barlabel">XP</span><div class="bar"><i id="xpFill"></i></div></div>
  <div class="barwrap map"><span class="barlabel">MAP</span><div class="bar"><i id="progFill"></i></div></div>
  <div class="meta"><div class="left"><span id="lvlBadge">LV 1</span><span id="weaponTag">Rusty Sword</span><span id="armorTag"></span><span id="keyTag" style="display:none;font-size:11px;font-weight:700;color:#ffd700;"></span><span id="coinTag" style="display:none;font-size:11px;font-weight:800;color:#ffd700;"></span><span id="goldTag" style="display:none;font-size:11px;font-weight:800;color:#ffd700;"></span><span id="powerTag" style="display:none;font-size:11px;font-weight:800;"></span><span id="slamTag" style="display:none;font-size:11px;font-weight:800;"></span><span id="dashTag" style="font-size:11px;font-weight:800;"></span><span id="fuelTag" style="display:none;"></span><span id="flipTag" style="display:none;"></span><span id="portalTag" style="display:none;"></span><span id="companionTag" style="display:none;"></span><span id="testTag" style="display:none;font-size:11px;font-weight:800;color:#e8a33d;">🛠 TEST</span></div><span id="stageTag">Stage 1</span></div>
</div>
<div id="bosshpwrap"><div id="bossname">Boss</div><div id="bosshp"><i></i></div></div>
<button id="pausebtn" class="hide">II</button>
<div id="controls" class="hide">
  <div id="joyzone"><div id="joy"><div id="joyknob"></div></div></div>
  <button class="btn" id="bDodge">DODGE</button>
  <button class="btn" id="bJump"><svg viewBox="0 0 24 24"><path d="M12 4l7 8h-4v8h-6v-8H5z"/></svg></button>
  <button class="btn" id="bAttack">SLASH</button>
  <button class="btn" id="bFlip">⇅</button>
  <button class="btn" id="bPortal">⊙</button>
  <button class="btn" id="bCommand">HOLD</button>
</div>
<div id="toast"></div>
<div id="overlay"><div class="card" id="ovcard"></div></div>
<div id="cutscene" class="hide">
  <canvas id="cutCanvas" style="position:absolute;top:0;left:0;width:100%;height:100%;z-index:0;"></canvas>
  <div id="cutText" style="position:relative;z-index:1;"></div>
  <div id="cutSkip">Tap to Skip</div>
</div>
<audio id="bgMusic" loop preload="auto" src="./music.mp3"></audio>
<script>
  let _musicStarted = false;
  const tryStartMusic = () => {
    if(!_musicStarted && (typeof meta !== 'undefined' ? meta.soundOn : true)){
      const m = document.getElementById('bgMusic');
      if(m) { m.volume = (typeof meta !== 'undefined' ? meta.musicVolume : 0.4); m.play().then(()=>{_musicStarted=true;}).catch(()=>{}); }
    }
  };
  document.addEventListener('click', tryStartMusic);
  document.addEventListener('keydown', tryStartMusic);
</script>

<script>
/* Touch click-synthesis shim. On some Android Chrome builds, tapping a button
   inside a scrollable overlay (the menus live in #overlay, which scrolls in
   landscape) never produces a `click`: the browser holds it pending a possible
   scroll, then drops it. pointerdown/up still fire, so for a clean stationary
   tap we synthesize the click ourselves — unless a real click already fired. */
(function(){
  // ---- Tap → click synthesis (some Android builds drop the click on a tap
  //      inside a scroll region). Covers <button>/onclick handlers AND native
  //      controls like the Hardcore / Test Mode checkboxes (which fire onchange,
  //      not onclick) and their <label>s — else those can't be toggled on touch. */
  const CLICKABLE=/^(BUTTON|A|INPUT|LABEL|SELECT|TEXTAREA)$/;
  const actionable=el=>el&&el.nodeType===1&&(typeof el.onclick==='function'||CLICKABLE.test(el.tagName)||el.getAttribute('role')==='button');
  let downX=0,downY=0,downT=0,lastNativeClick=0;
  // Only a REAL browser click should suppress synthesis (so we don't double-fire).
  // Our own synthesized clicks are untrusted — ignoring them lets two quick taps
  // on different controls (e.g. toggling both Hardcore and Test Mode) both land.
  document.addEventListener('click',(e)=>{if(e.isTrusted)lastNativeClick=Date.now();},true);
  document.addEventListener('pointerdown',e=>{downX=e.clientX;downY=e.clientY;downT=Date.now();},true);
  document.addEventListener('pointerup',e=>{
    if(e.pointerType==='mouse')return;                        // mouse clicks fine on its own
    if(Math.hypot(e.clientX-downX,e.clientY-downY)>12)return; // a drag/scroll, not a tap
    if(Date.now()-downT>700)return;                           // a long press, not a tap
    let el=e.target;
    while(el&&el!==document&&!actionable(el))el=el.parentElement;
    if(!el||el===document)return;
    if(el.tagName==='INPUT'&&el.type==='range')return;        // sliders are dragged, not clicked
    const target=el;
    setTimeout(()=>{
      if(Date.now()-lastNativeClick<400)return;               // a real click already handled it
      target.click();
    },100);
  },true);

  // ---- Manual scroll for overlay menus. The root sets touch-action:none /
  //      overscroll-behavior:none so gameplay never scrolls the page — but that
  //      also kills native wheel/touch scrolling inside menus (Level Select,
  //      Settings). Drive scrollTop ourselves for the nearest scroll container. */
  const findScroller=(node)=>{
    while(node&&node.nodeType===1&&node!==document.body){
      if(node.scrollHeight-node.clientHeight>1){
        const oy=getComputedStyle(node).overflowY;
        if(oy==='auto'||oy==='scroll')return node;
      }
      node=node.parentElement;
    }
    return null;
  };
  document.addEventListener('wheel',e=>{
    const s=findScroller(e.target); if(!s)return;
    s.scrollTop+=e.deltaY; e.preventDefault();
  },{passive:false});
  let ty=null,scroller=null,moved=0;
  document.addEventListener('touchstart',e=>{
    scroller=findScroller(e.target); ty=scroller?e.touches[0].clientY:null; moved=0;
  },{passive:true});
  document.addEventListener('touchmove',e=>{
    if(ty===null||!scroller)return;
    const y=e.touches[0].clientY,dy=y-ty; ty=y; moved+=Math.abs(dy);
    if(moved>3){ scroller.scrollTop-=dy; e.preventDefault(); }
  },{passive:false});
  const endTouch=()=>{ty=null;scroller=null;};
  document.addEventListener('touchend',endTouch);
  document.addEventListener('touchcancel',endTouch);
})();
</script>
<script src="littlejs.min.js"></script>
<script>
'use strict';
/* ================================================================
   BLADEFALL v5.1.0 — Step 2: Full Playable Game
   ECS architecture on LittleJS engine.
   ================================================================ */
const VERSION='6.5.0';

/* ================================================================
   SECTION 1: ENTITY-COMPONENT-SYSTEM
   ================================================================ */
class EntityManager{
  constructor(){this._nid=1;this._c=new Map;this._e=new Set;this._dq=[];this._sys=[];}
  createEntity(){const id=this._nid++;this._e.add(id);return id;}
  destroyEntity(id){this._dq.push(id);}
  entityExists(id){return this._e.has(id);}
  flush(){for(const id of this._dq){for(const[,s]of this._c)s.delete(id);this._e.delete(id);}this._dq.length=0;}
  add(eid,name,data){if(!this._c.has(name))this._c.set(name,new Map);this._c.get(name).set(eid,data);return data;}
  rem(eid,name){const s=this._c.get(name);return s?s.delete(eid):false;}
  get(eid,name){const s=this._c.get(name);return s?s.get(eid):undefined;}
  has(eid,name){const s=this._c.get(name);return s?s.has(eid):false;}
  store(name){return this._c.get(name)||new Map;}
  query(...names){
    if(!names.length)return[];
    let sn=names[0],ss=Infinity;
    for(const n of names){const s=this._c.get(n);const sz=s?s.size:0;if(sz<ss){ss=sz;sn=n;}}
    if(ss===0)return[];
    const sm=this._c.get(sn),r=[];
    for(const eid of sm.keys()){let ok=true;for(const n of names){if(n===sn)continue;const s=this._c.get(n);if(!s||!s.has(eid)){ok=false;break;}}if(ok)r.push(eid);}
    return r;
  }
  register(name,req,fn,phase='update'){this._sys.push({name,req,fn,phase});}
  run(phase,dt){for(const s of this._sys){if(s.phase!==phase)continue;s.fn(this.query(...s.req),this,dt);}}
  info(){const cc={};for(const[n,s]of this._c)cc[n]=s.size;return{entities:this._e.size,components:cc,systems:this._sys.length};}
}

/* ================================================================
   SECTION 2: GAME DATA — Rarity, Elements, Weapons, Armor, Stages, Enemies
   ================================================================ */
let VW=0,VH=0,GROUND_Y=0;
function recalcVP(){VW=mainCanvas.width;VH=mainCanvas.height;GROUND_Y=VH-Math.max(120,VH*0.20);}

/* Rarity */
const RARITY={common:{name:'Common',color:'#b9c0cc',base:1000,mul:1,tier:0},uncommon:{name:'Uncommon',color:'#5fd17a',base:300,mul:1.3,tier:1},rare:{name:'Rare',color:'#4aa3e0',base:80,mul:1.7,tier:2},epic:{name:'Epic',color:'#b06bff',base:16,mul:2.25,tier:3},legendary:{name:'Legendary',color:'#f0a93a',base:2.6,mul:3,tier:4}};
const RORDER=['common','uncommon','rare','epic','legendary'];
function rarGlow(r){return[0,3,6,10,15][RARITY[r].tier];}
function rollRarity(){
  const luck=(G.stageIndex*0.5)+(G.ngPlus*2.5)+(Math.floor(G.p.level/2)*0.2);
  const boost=1+Math.min(luck,22)*0.085;let pool=[],total=0;
  RORDER.forEach((r,i)=>{const w=RARITY[r].base*Math.pow(boost,i);pool.push(w);total+=w;});
  let roll=Math.random()*total;for(let i=0;i<pool.length;i++){roll-=pool[i];if(roll<=0)return RORDER[i];}return'common';
}

/* Elements */
const WEAK={fire:'ice',ice:'fire',poison:'holy',storm:'arcane',void:'holy',arcane:'storm',holy:'void'};
function elColor(el){return{fire:'#ff7a3a',ice:'#7fd6ff',poison:'#86e05a',arcane:'#c47bff',void:'#b06bff',storm:'#9fe0ff',holy:'#ffe9a8'}[el]||null;}
function elemMod(wEl,eEl){if(!wEl||!eEl)return 1;if(wEl==='void')return 1.15;if(wEl===eEl)return 0.6;if(WEAK[eEl]===wEl)return 1.5;return 1;}

