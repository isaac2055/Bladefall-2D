/* ================================================================
   SECTION 3: PERSISTENCE & GAME STATE
   ================================================================ */
const SAVE_KEY='bladefall_v2';
const LEADERBOARD_KEY='bladefall_leaderboards_v1';
function loadSave(){try{return JSON.parse(localStorage.getItem(SAVE_KEY))||{};}catch(e){return{};}}
function persist(){try{localStorage.setItem(SAVE_KEY,JSON.stringify(meta));}catch(e){}}
function loadLeaderboards(){
  const fresh={base:[],ng1:[],ng2:[],rush:[],lastName:''};
  try{
    const saved=JSON.parse(localStorage.getItem(LEADERBOARD_KEY))||{};
    const out=Object.assign(fresh,saved);
    for(const k of ['base','ng1','ng2','rush'])if(!Array.isArray(out[k]))out[k]=[];
    return out;
  }catch(e){return fresh;}
}
function persistLeaderboards(){try{localStorage.setItem(LEADERBOARD_KEY,JSON.stringify(leaderboards));}catch(e){}}
const leaderboards=loadLeaderboards();
const meta=Object.assign({ngPlus:0,bestStage:0,soundOn:true,musicVolume:0.4,totalKills:0,bossKills:0,kingKills:0,tyrantKills:0,magicBossKills:0,rangedBossKills:0,legendaryFound:0,flawlessStages:0,maxLevel:1,lastNgHp:1,lastNgDmg:1,autoAttack:false,autoKeep:false,run:null,achievements:{},keybinds:null,coins:{},vaultCleared:false,followerTier:0,devUnlocked:false,reach:null,gold:0,skin:'warden',skinsOwned:null,bossRushBest:0,bossTypeKills:null},loadSave());
meta.bossTypeKills=meta.bossTypeKills||{};
// Per-tier furthest-stage-reached (level select gating). Old saves only tracked
// a single bestStage — fold it into the Base tier.
meta.reach=meta.reach||{};meta.reach[0]=Math.max(meta.reach[0]||0,meta.bestStage||0);
// Test Mode is a developer tool: without the dev unlock it stays off, so a
// shared save can't ship with god mode pre-enabled.
if(!meta.devUnlocked)meta.testMode=false;
meta.coins=meta.coins||{};
meta.skinsOwned=Object.assign({warden:true},meta.skinsOwned||{});
if(!meta.skinsOwned[meta.skin])meta.skin='warden';

/* Global mutable game state (non-ECS) */
let G=null,mode='title',queueLevelUp=0;

/* ---- Character skins. Each is a full hero palette plus one small, real perk.
   Earned by playing (unlock condition) or bought outright with gold. */
const bossBeaten=t=>(m=>((m.bossTypeKills||{})[t]||0)>0);
const SKINS={
  warden:{name:'The Warden',cost:0,unlock:m=>true,unlockDesc:'The last Warden — always yours',
    perkDesc:'No perk. Pure, balanced steel.',perk:{},
    pal:{A:'#37485e',AL:'#5a7594',AH:'#8aa6c4',TR:'#e8c87a',CAPE:'#7a1f2e',CAPE2:'#4a0f1c',MET:'#aeb9c6',GL:'#9fc4ff'}},
  crimson:{name:'Crimson Reaver',cost:400,unlock:bossBeaten('brute'),unlockDesc:'Defeat The Brute',
    perkDesc:'+3% lifesteal — the armor drinks',perk:{ls:0.03},
    pal:{A:'#5e2430',AL:'#8a3644',AH:'#c45a66',TR:'#2a2a30',CAPE:'#1a1a20',CAPE2:'#0e0e12',MET:'#c6aeae',GL:'#ff5a5a'}},
  gilded:{name:'Gilded Knight',cost:600,unlock:bossBeaten('warden'),unlockDesc:'Defeat The Warden',
    perkDesc:'+30% gold from every kill',perk:{goldMul:1.3},
    pal:{A:'#6e5a24',AL:'#9a8036',AH:'#d4b45a',TR:'#fff0b8',CAPE:'#3a2f4a',CAPE2:'#241c30',MET:'#e8d8a8',GL:'#ffe9a8'}},
  frostbound:{name:'Frostbound',cost:500,unlock:bossBeaten('sorcerer'),unlockDesc:'Defeat the Frost Sorcerer',
    perkDesc:'-12% dash cooldown — ice in the joints',perk:{dodgeMul:0.88},
    pal:{A:'#2e4a5e',AL:'#4a7694',AH:'#7fb6d4',TR:'#cfeaf8',CAPE:'#1f3a4e',CAPE2:'#122430',MET:'#cfe2ec',GL:'#7fd6ff'}},
  emberborn:{name:'Emberborn',cost:500,unlock:bossBeaten('colossus'),unlockDesc:'Defeat the Ember Colossus',
    perkDesc:'Melee strikes kindle a burn',perk:{emberMelee:1},
    pal:{A:'#5e3424',AL:'#94502a',AH:'#d47a3a',TR:'#ffd75a',CAPE:'#3a1010',CAPE2:'#240a0a',MET:'#c6a08a',GL:'#ff9a3a'}},
  voidshade:{name:'Void Shade',cost:0,unlock:bossBeaten('king'),unlockDesc:'Beat the base game — fell the Abyss King',
    perkDesc:'+8% speed · foes notice you later',perk:{speedMul:1.08,stealth:0.75},
    pal:{A:'#241a34',AL:'#3c2a54',AH:'#6a4a94',TR:'#b06bff',CAPE:'#140b22',CAPE2:'#0a0512',MET:'#8a7aa6',GL:'#c47bff'}},
};
function curSkin(){return SKINS[meta.skin]||SKINS.warden;}
function skinPerk(k,dflt){const v=curSkin().perk[k];return v===undefined?dflt:v;}
function skinUnlocked(id){return !!meta.skinsOwned[id]||SKINS[id].unlock(meta);}
function addGold(n){meta.gold=Math.max(0,Math.round((meta.gold||0)+n));}
/* Haptics: a tiny thump on phones, a silent no-op on desktop. */
function buzz(ms){try{if(navigator.vibrate)navigator.vibrate(ms);}catch(e){}}

/* Player stat helpers */
function freshGear(){return{helmet:null,chest:null,legs:null};}
function recomputeArmor(p){const m={hp:0,speedMul:1,atkSpeedMul:1,lifesteal:0,dodgeMul:1,powerMul:1,defense:0};let total=0;
  if(p.gear)for(const slot of SLOTIDS){const a=p.gear[slot];if(!a)continue;total+=a.defense;for(const af of a.affixes){if(af.stat==='hp')m.hp+=af.val;else if(af.stat==='lifesteal')m.lifesteal+=af.val;else if(af.stat==='speedMul')m.speedMul*=1+af.val;else if(af.stat==='atkSpeedMul')m.atkSpeedMul*=1+af.val;else if(af.stat==='dodgeMul')m.dodgeMul*=1-af.val;else if(af.stat==='powerMul')m.powerMul*=1+af.val;}}
  m.defense=total/(total+200);p.armorMods=m;}
function effMaxHp(p){return p.maxHp+(p.armorMods?p.armorMods.hp:0);}
function effPower(p){return p.stats.power*(p.armorMods?p.armorMods.powerMul:1)*(p.giantT>0?1.8:1);}
function effAtkSpeed(p){return p.stats.atkSpeed*(p.armorMods?p.armorMods.atkSpeedMul:1)*(p.adrenT>0?1.25:1);}
function effSpeed(p){return p.stats.speed*(p.armorMods?p.armorMods.speedMul:1)*skinPerk('speedMul',1);}
function effLifesteal(p){return Math.min(0.18, p.stats.lifesteal+(p.armorMods?p.armorMods.lifesteal:0)+((p.weapon&&p.weapon.lifesteal)||0)+skinPerk('ls',0));}
function effDodgeCd(p){return p.stats.dodgeCd*(p.armorMods?p.armorMods.dodgeMul:1)*skinPerk('dodgeMul',1);}
function defenseR(p){return p.armorMods?Math.min(0.5,p.armorMods.defense):0;}
function totalDefense(p){let t=0;if(p.gear)for(const s of SLOTIDS){if(p.gear[s])t+=p.gear[s].defense;}return t;}
function bestGearRarity(p){let best=-1,bc='#333';if(p.gear)for(const s of SLOTIDS){const a=p.gear[s];if(a&&RARITY[a.rarity].tier>best){best=RARITY[a.rarity].tier;bc=a.color;}}return bc;}

/* Snapshot for save/NG+ */
function snapOf(p){return{hp:p.hp,maxHp:p.maxHp,level:p.level,xp:p.xp,xpNext:p.xpNext,weapon:JSON.parse(JSON.stringify(p.weapon)),gear:cloneGear(p.gear),stats:JSON.parse(JSON.stringify(p.stats)),maxJumps:p.maxJumps,hasSlam:p.hasSlam,hasJetpack:p.hasJetpack,mods:Object.assign({},p.mods||{})};}
function cloneGear(g){const o=freshGear();if(g)for(const s of SLOTIDS){if(g[s])o[s]=JSON.parse(JSON.stringify(g[s]));}return o;}

/* ================================================================
   SECTION 4: INPUT (Keyboard + Touch)
   ================================================================ */
const input={left:false,right:false,down:false,jump:false,attack:false,dodge:false,jumpEdge:false,dodgeEdge:false,portal:false,portalEdge:false,command:false,commandEdge:false,jx:0,jz:0,pause:false};

/* Rebindable keyboard controls. meta.keybinds holds any user overrides (persisted);
   KB_DEFAULTS fills in whatever hasn't been rebound, including on first run. */
const KB_DEFAULTS={left:'ArrowLeft',right:'ArrowRight',jump:'Space',attack:'KeyW',dash:'KeyD',slam:'ArrowDown',flip:'KeyG',portal:'KeyF',companion:'KeyE',pause:'Escape'};
const KB_LABELS={left:'Move Left',right:'Move Right',jump:'Jump',attack:'Attack',dash:'Dash',slam:'Ground Slam',flip:'Gravity Flip',portal:'Portal Mouth',companion:'Companion Order',pause:'Pause'};
meta.keybinds=Object.assign({},KB_DEFAULTS,meta.keybinds||{});
// Two actions sharing one key is unplayable (a dash bound onto a direction key
// fires both at once). A save carrying duplicates gets its controls reset.
{const seen={};let dup=false;
 for(const a in KB_DEFAULTS){const c=meta.keybinds[a];if(seen[c])dup=true;seen[c]=true;}
 if(dup){meta.keybinds=Object.assign({},KB_DEFAULTS);try{persist();}catch(e){}}}
function kbCode(action){return meta.keybinds[action]||KB_DEFAULTS[action];}

/* Own key tracking, alongside the engine's. LittleJS wipes its ENTIRE key map on any
   frame where document.hasFocus() is false (and on blur) — so a held movement key
   could die mid-run and stay dead until OS autorepeat re-fired it, which read as the
   character "randomly stopping". These maps only clear on a real blur, and held keys
   are checked against BOTH sources. */
const RAW_KEYS={},RAW_PRESSED={};
window.addEventListener('keydown',e=>{if(!e.repeat)RAW_PRESSED[e.code]=true;RAW_KEYS[e.code]=true;});
window.addEventListener('keyup',e=>{RAW_KEYS[e.code]=false;});
window.addEventListener('blur',()=>{for(const k in RAW_KEYS)RAW_KEYS[k]=false;});
/* RAW_KEYS/RAW_PRESSED only — never LittleJS's key map. The engine aliases WASD
   onto the arrow keys, so its keyIsDown('ArrowRight') goes true when you press D:
   with dash bound to D, every dash read "moving right" and went right. */
function keyDownFor(action){const c=kbCode(action);return !!RAW_KEYS[c];}
function keyPressedFor(action){const c=kbCode(action);return !!RAW_PRESSED[c];}
function keyLabel(code){
  if(!code)return '?';
  const MAP={ArrowLeft:'←',ArrowRight:'→',ArrowUp:'↑',ArrowDown:'↓',Space:'Space',Escape:'Esc'};
  if(MAP[code])return MAP[code];
  if(code.startsWith('Key'))return code.slice(3);
  if(code.startsWith('Digit'))return code.slice(5);
  if(code.startsWith('Numpad'))return 'Num'+code.slice(6);
  return code;
}
function moveX(){
  let kmx = 0;
  if (input.left && input.right) kmx = input.lastMx || (input.right ? 1 : -1);
  else if (input.left) kmx = -1;
  else if (input.right) kmx = 1;
  if (kmx !== 0) return kmx;
  return input.jx || 0;
}

/* Touch button binding */
function bindBtn(id,key){
  const el=document.getElementById(id);let heldId=null;
  const set=v=>{el.classList.toggle('pressed',v);
    if(key==='jump'){if(v&&!input.jump)input.jumpEdge=true;input.jump=v;}
    else if(key==='dodge'){if(v&&!input.dodge)input.dodgeEdge=true;input.dodge=v;}
    else if(key==='flip'){if(v&&!input.flip)input.flipEdge=true;input.flip=v;}
    else if(key==='portal'){if(v&&!input.portal)input.portalEdge=true;input.portal=v;}
    else if(key==='command'){if(v&&!input.command)input.commandEdge=true;input.command=v;}
    else input[key]=v;};
  el.addEventListener('pointerdown',e=>{if(heldId!==null)return;e.preventDefault();heldId=e.pointerId;set(true);el.setPointerCapture&&el.setPointerCapture(e.pointerId);});
  const rel=e=>{if(e.pointerId!==heldId)return;e.preventDefault&&e.preventDefault();heldId=null;set(false);};
  el.addEventListener('pointerup',rel);el.addEventListener('pointercancel',rel);el.addEventListener('lostpointercapture',rel);
  el.addEventListener('contextmenu',e=>e.preventDefault());
}
bindBtn('bJump','jump');bindBtn('bAttack','attack');bindBtn('bDodge','dodge');bindBtn('bFlip','flip');bindBtn('bPortal','portal');bindBtn('bCommand','command');

/* Mouse-free upgrade selection: 1/2/3 (or Numpad 1/2/3) pick the matching choice. */
window.addEventListener('keydown', e=>{
  if(mode!=='upgrade')return;
  const idx={Digit1:0,Digit2:1,Digit3:2,Numpad1:0,Numpad2:1,Numpad3:2}[e.code];
  if(idx===undefined)return;
  const btn=document.querySelectorAll('.choice')[idx];
  if(btn)btn.click();
});
/* Portal confirmation stays keyboard-only friendly: Enter activates the focused
   affirmative action without making the player reach for a mouse between stages. */
window.addEventListener('keydown',e=>{
  if(mode!=='portal_prompt'||(e.code!=='Enter'&&e.code!=='NumpadEnter'))return;
  e.preventDefault();
  const yes=document.getElementById('portalYes');
  if(yes)yes.click();
});

/* Virtual joystick */
(function(){
  const zone=document.getElementById('joyzone'),joy=document.getElementById('joy'),knob=document.getElementById('joyknob');
  let pid=null,ox=0,oy=0;const R=46;
  const setKnob=(x,y)=>{knob.style.transform=`translate(${x}px,${y}px)`};
  zone.addEventListener('pointerdown',e=>{
    if(pid!==null || e.pointerType==='mouse')return;
    pid=e.pointerId;ox=e.clientX;oy=e.clientY;
    joy.style.display='block';const zr=zone.getBoundingClientRect();joy.style.left=(ox-zr.left-52)+'px';joy.style.top=(oy-zr.top-52)+'px';setKnob(0,0);zone.setPointerCapture&&zone.setPointerCapture(e.pointerId);});
  zone.addEventListener('pointermove',e=>{if(e.pointerId!==pid)return;e.preventDefault();let dx=e.clientX-ox,dy=e.clientY-oy;const d=Math.sqrt(dx*dx+dy*dy);if(d>R){dx=dx/d*R;dy=dy/d*R;}setKnob(dx,dy);input.jx=dx/R;input.jz=dy/R;});
  const rel=e=>{if(e.pointerId!==pid)return;pid=null;joy.style.display='none';input.jx=0;input.jz=0;setKnob(0,0);};
  zone.addEventListener('pointerup',rel);zone.addEventListener('pointercancel',rel);zone.addEventListener('lostpointercapture',rel);
  zone.addEventListener('contextmenu',e=>e.preventDefault());
})();

/* Pause button */
document.getElementById('pausebtn').addEventListener('pointerdown',e=>{e.preventDefault();if(mode==='play')openPause();});

/* iOS anti-zoom */
['gesturestart','gesturechange','gestureend'].forEach(t=>document.addEventListener(t,e=>e.preventDefault()));
let _lastTouchEnd=0;
document.addEventListener('touchend',e=>{if(e.target.closest&&e.target.closest('#overlay'))return;const now=Date.now();if(now-_lastTouchEnd<=300)e.preventDefault();_lastTouchEnd=now;},{passive:false});

/* ================================================================
   SECTION 5: PROCEDURAL AUDIO (ZzFX)
   ================================================================ */
/* Impact sounds are hand-built Web Audio, not ZzFX: real white noise swept
   through a bandpass, over a pitch-dropping sine body. ZzFX's tonal shapes
   always read "arcade beep"; a blade landing should read leather and bone. */
const _noiseBuf=(()=>{let b=null;return(ac)=>{
  if(b)return b;
  const len=(ac.sampleRate*0.5)|0;
  b=ac.createBuffer(1,len,ac.sampleRate);
  const d=b.getChannelData(0);
  for(let i=0;i<len;i++)d[i]=Math.random()*2-1;
  return b;};})();
function impactSfx(o){
  try{
    const ac=(typeof audioContext!=='undefined'&&audioContext)||null;if(!ac)return;
    if(ac.state==='suspended')ac.resume();
    const t=ac.currentTime;
    const r=0.88+Math.random()*0.24;   // every strike lands a little different
    // filtered-noise layer: [f0,f1,dur,vol,filterType,Q]
    for(const L of o.layers||[]){
      const src=ac.createBufferSource();src.buffer=_noiseBuf(ac);
      src.playbackRate.value=r;
      const flt=ac.createBiquadFilter();flt.type=L[4];flt.Q.value=L[5]||0.9;
      flt.frequency.setValueAtTime(L[0]*r,t);
      flt.frequency.exponentialRampToValueAtTime(Math.max(40,L[1]*r),t+L[2]);
      const g=ac.createGain();
      g.gain.setValueAtTime(L[3],t);
      g.gain.exponentialRampToValueAtTime(0.001,t+L[2]);
      src.connect(flt);flt.connect(g);g.connect(ac.destination);
      src.start(t,Math.random()*0.25);src.stop(t+L[2]+0.02);
    }
    // sine body with a pitch drop: the weight under the crack
    if(o.body){
      const os=ac.createOscillator();os.type='sine';
      os.frequency.setValueAtTime(o.bodyF*r,t);
      os.frequency.exponentialRampToValueAtTime(Math.max(26,o.bodyF*r*(o.drop||0.45)),t+o.bodyDur);
      const g2=ac.createGain();
      g2.gain.setValueAtTime(0.0001,t);
      g2.gain.exponentialRampToValueAtTime(o.body,t+0.006);   // 6ms attack: thump, not click
      g2.gain.exponentialRampToValueAtTime(0.001,t+o.bodyDur);
      os.connect(g2);g2.connect(ac.destination);
      os.start(t);os.stop(t+o.bodyDur+0.02);
    }
  }catch(e){}
}
const SFX={
  // the swing itself: pure air — two breathy noise sweeps, no tone at all
  slash(){impactSfx({layers:[[500,2600,0.13,0.13,'bandpass',1.6],
                            [300,1200,0.16,0.09,'bandpass',2.2]]});},
  // a bolt leaving: a muffled release of air, not a laser
  shoot(){impactSfx({layers:[[1300,320,0.09,0.15,'bandpass',1.2]],body:.10,bodyF:150,bodyDur:0.08,drop:.6});},
  // blade meets flesh: an 8ms snap, a thock sweeping down, a knuckle of bass
  hit(){impactSfx({layers:[[2600,1500,0.045,0.30,'highpass',0.7],
                          [900,240,0.10,0.30,'bandpass',1.1]],
                   body:.20,bodyF:150,bodyDur:0.12,drop:.45});},
  // taking a wound: a dark thud with grit and a sub drop — a body blow, no chime
  hurt(){impactSfx({layers:[[1400,300,0.06,0.15,'bandpass',1.0],
                           [600,90,0.26,0.34,'lowpass',0.8]],
                    body:.30,bodyF:95,bodyDur:0.34,drop:.40});},
  jump(){impactSfx({layers:[[600,1500,0.08,0.09,'bandpass',1.5]]});},   // a puff of effort
  land(){impactSfx({layers:[[420,90,0.09,0.14,'lowpass',0.8]],body:.10,bodyF:95,bodyDur:0.09,drop:.55});},
  dodge(){impactSfx({layers:[[350,2000,0.13,0.13,'bandpass',1.8]]});},   // pure air, faster than slash
  // a foe collapsing: a dark wet crunch settling into dust — no tone anywhere
  enemyDie(){impactSfx({layers:[[900,140,0.24,0.22,'lowpass',0.9],
                               [2200,600,0.05,0.10,'bandpass',1.0]],
                        body:.16,bodyF:70,bodyDur:0.28,drop:.35});},
  levelup(){zzfx(...[.04,,523,.01,.08,.16,0,.5,,,,,,,,,,.8,.04]);setTimeout(()=>zzfx(...[.04,,659,.01,.08,.16,0,.5,,,,,,,,,,.8,.04]),85);setTimeout(()=>zzfx(...[.04,,784,.01,.08,.14,0,.5,,,,,,,,,,.8,.04]),170);},
  pickup(){zzfx(...[.03,,660,.01,.05,.1,0,.5,,,,,,,,,,.8,.03]);setTimeout(()=>zzfx(...[.03,,990,.01,.07,.16,0,.5,,,,,,,,,,.8,.03]),70);},
  // a boss arrival/fall: a long rolling rumble
  boss(){impactSfx({layers:[[300,55,0.55,0.28,'lowpass',1.2]],body:.22,bodyF:52,bodyDur:0.6,drop:.5});},
  win(){zzfx(...[.04,,523,.01,.1,.2,0,.5,,,,,,,,,,.8,.04]);setTimeout(()=>zzfx(...[.04,,659,.01,.1,.2,0,.5,,,,,,,,,,.8,.04]),115);setTimeout(()=>zzfx(...[.04,,784,.01,.1,.2,0,.5,,,,,,,,,,.8,.04]),230);setTimeout(()=>zzfx(...[.04,,1047,.01,.12,.2,0,.5,,,,,,,,,,.8,.04]),345);},
  magic(el){zzfx(...[.04,,520,.02,.1,.2,0,.8,,,,,,,,,,,.04]);}
};

/* ================================================================
   SECTION 6: DRAWING UTILITIES
   ================================================================ */
function tint(a,b,t){const pa=hx(a),pb=hx(b);return'rgb('+Math.round(pa[0]+(pb[0]-pa[0])*t)+','+Math.round(pa[1]+(pb[1]-pa[1])*t)+','+Math.round(pa[2]+(pb[2]-pa[2])*t)+')';}
function hx(c){
  // Accept both #hex and rgb()/rgba() — colors produced by tint() are rgb strings,
  // and they get fed back in when a tinted color is tinted again (e.g. a burning boss).
  if(c&&c[0]!=='#'){const m=String(c).match(/[\d.]+/g);if(m&&m.length>=3)return[+m[0],+m[1],+m[2]];}
  c=c.replace('#','');if(c.length===3)c=c.split('').map(x=>x+x).join('');return[parseInt(c.substr(0,2),16),parseInt(c.substr(2,2),16),parseInt(c.substr(4,2),16)];}
function rr(c,x,y,w,h,r){c.beginPath();c.moveTo(x+r,y);c.arcTo(x+w,y,x+w,y+h,r);c.arcTo(x+w,y+h,x,y+h,r);c.arcTo(x,y+h,x,y,r);c.arcTo(x,y,x+w,y,r);c.closePath();}
function shadow(c,cy,w){c.save();c.globalAlpha=0.28;c.fillStyle='#000';c.beginPath();c.ellipse(0,cy,w,w*0.28,0,0,6.28);c.fill();c.restore();}
function lineC(c,a,b,cc,d){c.beginPath();c.moveTo(a,b);c.lineTo(cc,d);c.stroke();}
function triC(c,x1,y1,x2,y2,x3,y3){c.beginPath();c.moveTo(x1,y1);c.lineTo(x2,y2);c.lineTo(x3,y3);c.closePath();c.fill();}
function eyes(c,cx,cy,dark,glow){c.fillStyle=glow||'#fff';c.beginPath();c.arc(cx-6,cy,3.4,0,6.28);c.arc(cx+6,cy,3.4,0,6.28);c.fill();c.fillStyle=dark||'#000';c.beginPath();c.arc(cx-5,cy,1.6,0,6.28);c.arc(cx+7,cy,1.6,0,6.28);c.fill();}
/* Accepts '#rgb'/'#rrggbb' or the 'rgb(r,g,b)' that tint() returns — passing the
   latter to a hex-only parser yields rgba(NaN,...), which silently drops the fill. */
function rgba(col,a){
  if(col&&col[0]==='#'){const p=hx(col);return'rgba('+p[0]+','+p[1]+','+p[2]+','+a+')';}
  const m=String(col).match(/[\d.]+/g);
  return(m&&m.length>=3)?'rgba('+m[0]+','+m[1]+','+m[2]+','+a+')':col;
}

/* Deterministic noise. Scenery detail must be a pure function of position, or it
   strobes every frame (which is exactly what the old ceiling edge did). */
function hash1(n){n=(n|0)^((n|0)<<13);return(((n*(n*n*15731+789221)+1376312589)&0x7fffffff)/0x7fffffff);}
function hash2(x,y){return hash1((x|0)*374761393+(y|0)*668265263);}

/* Gradient cache. Canvas gradients live in user space and are transformed at fill
   time, so one object per (key,size) can serve every platform of that size. */
const _grads=new Map();
function grad(c,key,x0,y0,x1,y1,stops){
  let g=_grads.get(key);
  if(!g){g=c.createLinearGradient(x0,y0,x1,y1);for(const s of stops)g.addColorStop(s[0],s[1]);_grads.set(key,g);}
  return g;
}

/* ---- Art direction -----------------------------------------------------------
   One palette per stage theme drives stone, top-dressing, parallax and weather,
   so each biome reads distinctly without any per-stage special-casing. */
const THEME_ART={
  plains  :{rock:'#48536b',lit:'#6e7ea3',dark:'#1e2536',accent:'#5f9153',accent2:'#7cb567',far:'#222d46',mid:'#1a2338',haze:'#3d5480',kind:'hills' ,amb:'dust' ,ambCol:'#b9c9e6'},
  forest  :{rock:'#3d4a3e',lit:'#5d7259',dark:'#161e18',accent:'#4f8f3a',accent2:'#79c258',far:'#17281d',mid:'#101d15',haze:'#2c5138',kind:'trees' ,amb:'leaf' ,ambCol:'#6fae4e'},
  badlands:{rock:'#5a4038',lit:'#846056',dark:'#241713',accent:'#8a5a3a',accent2:'#c07a45',far:'#33201a',mid:'#241512',haze:'#6b3a28',kind:'mesa'  ,amb:'dust' ,ambCol:'#d69a6a'},
  canyon  :{rock:'#6b5336',lit:'#9a7a4e',dark:'#2b1f12',accent:'#a8813f',accent2:'#d4ab5e',far:'#3d2c19',mid:'#2a1d10',haze:'#7d5a2e',kind:'mesa'  ,amb:'dust' ,ambCol:'#e0c088'},
  ruins   :{rock:'#4a4560',lit:'#6f688e',dark:'#1f1c2e',accent:'#5b4f86',accent2:'#8f7ec4',far:'#241f3c',mid:'#181428',haze:'#4a3d7a',kind:'ruins' ,amb:'dust' ,ambCol:'#b3a6e0'},
  dungeon :{rock:'#4b3550',lit:'#6f5076',dark:'#1f1424',accent:'#7a3f80',accent2:'#b063b8',far:'#2a1a30',mid:'#1c1020',haze:'#5e2f66',kind:'arches',amb:'dust' ,ambCol:'#c78fd0'},
  frost   :{rock:'#41556b',lit:'#6d879f',dark:'#1a2531',accent:'#a8d4e8',accent2:'#e8f6ff',far:'#22303f',mid:'#16212c',haze:'#4e7899',kind:'peaks' ,amb:'snow' ,ambCol:'#e8f6ff'},
  volcano :{rock:'#3a2823',lit:'#5c423a',dark:'#150c0a',accent:'#c43a12',accent2:'#ff8a2a',far:'#2a1210',mid:'#1a0a08',haze:'#8c2d12',kind:'volcano',amb:'ember',ambCol:'#ff7a3a'},
  void    :{rock:'#3b2c53',lit:'#5d477e',dark:'#170f24',accent:'#8a4fd0',accent2:'#c47bff',far:'#1e1233',mid:'#140a22',haze:'#5a2d9c',kind:'void'  ,amb:'void' ,ambCol:'#c47bff'},
  apex    :{rock:'#2e2242',lit:'#4b3a6b',dark:'#100a1a',accent:'#6f3fb5',accent2:'#a86bff',far:'#150d26',mid:'#0b0614',haze:'#48227e',kind:'void'  ,amb:'void' ,ambCol:'#a86bff'}
};
function art(){return THEME_ART[(STAGES[G?G.stageIndex:0]||{}).theme]||THEME_ART.plains;}

/* A chiselled stone slab: lit top face, bevelled sides, cracks, dark underside. */
function stoneSlab(c,x,y,w,h,A,seed){
  c.fillStyle=grad(c,'slab'+A.rock+h,0,y,0,y+h,[[0,A.rock],[0.55,tint(A.rock,'#000',0.28)],[1,A.dark]]);
  c.fillRect(x,y,w,h);
  c.fillStyle=A.lit;c.fillRect(x,y,w,3);                       // sunlit cap
  c.fillStyle=rgba(A.lit,0.35);c.fillRect(x,y+3,2,h-3);        // left bevel
  c.fillStyle=rgba(A.dark,0.6);c.fillRect(x+w-2,y+3,2,h-3);    // right bevel
  c.fillStyle=rgba(A.dark,0.55);c.fillRect(x,y+h-2,w,2);       // underside
  // chiselled block seams + cracks, fixed to world position
  c.strokeStyle=rgba(A.dark,0.45);c.lineWidth=1;
  const step=26;
  for(let i=step;i<w-4;i+=step){
    const j=Math.floor((x+i)/step);
    const off=(hash1(j)-0.5)*5;
    c.beginPath();c.moveTo(x+i+off,y+3);c.lineTo(x+i+off*0.4,y+h-2);c.stroke();
  }
}
/* Top-dressing: grass tufts, snow caps, embers — whatever the biome wears. */
function slabDressing(c,x,y,w,A,seed){
  const k=A.kind;
  if(A.amb==='snow'){
    c.fillStyle=A.accent2;c.beginPath();c.moveTo(x,y+1);
    for(let i=0;i<=w;i+=8){c.lineTo(x+i,y+1-1.5-hash1(seed+i)*2.5);}
    c.lineTo(x+w,y+3);c.lineTo(x,y+3);c.closePath();c.fill();
    return;
  }
  if(A.amb==='ember'){
    c.fillStyle=A.accent;
    for(let i=4;i<w-4;i+=13){if(hash1(seed+i)<0.45)c.fillRect(x+i,y-1,3,2);}
    c.fillStyle=rgba(A.accent2,0.5+0.3*Math.sin(G.time*4+seed));
    for(let i=7;i<w-4;i+=21){if(hash1(seed+i*3)<0.4)c.fillRect(x+i,y-2,2,2);}
    return;
  }
  if(k==='hills'||k==='trees'){ // grass / moss fringe
    c.fillStyle=A.accent;c.fillRect(x,y-1,w,3);
    c.fillStyle=A.accent2;
    for(let i=2;i<w-2;i+=6){
      const hh=2+hash1(seed+i)*5, ln=Math.sin(G.time*1.5+i*0.3)*1.2;
      c.beginPath();c.moveTo(x+i,y);c.lineTo(x+i+ln,y-hh);c.lineTo(x+i+2,y);c.closePath();c.fill();
    }
    return;
  }
  if(k==='void'){ // faint crystal glow along the lip
    c.fillStyle=rgba(A.accent2,0.35+0.15*Math.sin(G.time*3+seed));
    c.fillRect(x,y-1,w,2);
    return;
  }
  c.fillStyle=rgba(A.accent,0.5);c.fillRect(x,y-1,w,2);
}

/* Weapon art */
/* Forged look: dark spine, bright edge, gold furniture, rarity + element glow.
   `charge` (0..1) makes the weapon visibly gather power before a heavy strike. */
function drawWeaponArt(c,w,charge){
  const mag=w.sch==='mag',blade=w.blade||(mag?(elColor(w.el)||'#c9a6ff'):'#dfe5ec');
  const edge=tint(blade,'#ffffff',0.55),spine=tint(blade,'#000000',0.45);
  const hilt='#6b5430',gold='#e0bb63',grip='#3a2418';
  const el=elColor(w.el);
  c.save();c.lineCap='round';c.lineJoin='round';
  c.shadowColor=el||w.color||'#fff';
  c.shadowBlur=rarGlow(w.rarity)+(charge?18*charge:0)+(el?4:0);
  // pommel + grip shared by the hafted/hilted weapons
  const hiltKit=()=>{c.fillStyle=grip;c.fillRect(-6,-1.8,8,3.6);c.fillStyle=gold;c.beginPath();c.arc(-7,0,2.4,0,6.28);c.fill();};
  switch(w.art){
    case'sword':{
      hiltKit();
      c.fillStyle=gold;c.fillRect(1,-6,3,12);                       // crossguard
      c.fillStyle=spine;c.beginPath();c.moveTo(4,-2.8);c.lineTo(25,-2.4);c.lineTo(32,0);c.lineTo(25,2.4);c.lineTo(4,2.8);c.closePath();c.fill();
      c.fillStyle=blade;c.beginPath();c.moveTo(4,-2.8);c.lineTo(25,-2.4);c.lineTo(32,0);c.lineTo(25,-0.2);c.lineTo(4,-0.4);c.closePath();c.fill();
      c.strokeStyle=edge;c.lineWidth=1;lineC(c,5,-2.1,30,-0.4);     // edge highlight
      c.fillStyle=rgba(gold,0.55);c.fillRect(4,-0.5,18,1);          // fuller
      break;}
    case'dagger':{
      hiltKit();c.fillStyle=gold;c.fillRect(0,-4,2.5,8);
      c.fillStyle=spine;c.beginPath();c.moveTo(2,-2.2);c.lineTo(14,-1.4);c.lineTo(18,0);c.lineTo(14,1.4);c.lineTo(2,2.2);c.closePath();c.fill();
      c.fillStyle=blade;c.beginPath();c.moveTo(2,-2.2);c.lineTo(14,-1.4);c.lineTo(18,0);c.lineTo(2,0);c.closePath();c.fill();
      break;}
    case'spear':{
      c.strokeStyle=grip;c.lineWidth=3.4;lineC(c,-6,0,30,0);
      c.strokeStyle=rgba(gold,0.7);c.lineWidth=1;lineC(c,-6,-1.2,30,-1.2);
      c.fillStyle=gold;c.fillRect(27,-3,3,6);
      c.fillStyle=spine;triC(c,30,-4.6,44,0,30,4.6);
      c.fillStyle=blade;triC(c,30,-4.6,44,0,30,0);
      c.strokeStyle=edge;c.lineWidth=0.9;lineC(c,31,-3.4,43,-0.2);
      break;}
    case'axe':{ // haft with a bearded single-bit head
      c.strokeStyle=grip;c.lineWidth=4;lineC(c,-7,0,24,0);
      c.fillStyle=gold;c.beginPath();c.arc(-8,0,2.2,0,6.28);c.fill();
      c.fillStyle=spine;                                            // head body
      c.beginPath();c.moveTo(16,-4);c.lineTo(24,-13);c.quadraticCurveTo(33,-6,32,2);
      c.quadraticCurveTo(28,10,20,9);c.lineTo(16,4);c.closePath();c.fill();
      c.fillStyle=blade;                                            // bevelled cutting edge
      c.beginPath();c.moveTo(24,-13);c.quadraticCurveTo(33,-6,32,2);c.quadraticCurveTo(28,10,20,9);
      c.quadraticCurveTo(29,2,24,-13);c.closePath();c.fill();
      c.strokeStyle=edge;c.lineWidth=1.3;
      c.beginPath();c.moveTo(24.5,-11.5);c.quadraticCurveTo(32,-5,31,1.6);c.stroke();
      c.fillStyle=gold;c.fillRect(14,-5,3.4,10);                    // langet
      break;}
    case'great':{
      hiltKit();
      c.fillStyle=gold;c.fillRect(1,-8,3.4,16);
      c.fillStyle=spine;c.beginPath();c.moveTo(4,-4.4);c.lineTo(28,-3.6);c.lineTo(36,0);c.lineTo(28,3.6);c.lineTo(4,4.4);c.closePath();c.fill();
      c.fillStyle=blade;c.beginPath();c.moveTo(4,-4.4);c.lineTo(28,-3.6);c.lineTo(36,0);c.lineTo(4,0);c.closePath();c.fill();
      c.strokeStyle=edge;c.lineWidth=1.2;lineC(c,5,-3.2,34,-0.4);
      c.fillStyle=rgba(gold,0.85);c.fillRect(4,-1,21,2);
      break;}
    case'hammer':{
      c.strokeStyle=grip;c.lineWidth=4;lineC(c,-6,0,20,0);
      c.fillStyle=spine;rr(c,17,-9,14,18,2);c.fill();
      c.fillStyle=blade;rr(c,17,-9,14,8,2);c.fill();
      c.fillStyle=rgba(edge,0.8);c.fillRect(29,-7,2,14);
      c.fillStyle=gold;c.fillRect(15,-6,2.5,12);
      break;}
    case'scythe':{
      c.strokeStyle=grip;c.lineWidth=3.4;lineC(c,-8,0,30,0);
      c.fillStyle=gold;c.fillRect(27,-2.5,4,5);
      c.strokeStyle=spine;c.lineWidth=6;c.beginPath();c.arc(30,-6,13,-0.25,1.95);c.stroke();
      c.strokeStyle=blade;c.lineWidth=2.6;c.beginPath();c.arc(30,-6,14.4,-0.25,1.95);c.stroke();
      c.strokeStyle=edge;c.lineWidth=1;c.beginPath();c.arc(30,-6,15.6,-0.2,1.8);c.stroke();
      break;}
    case'bow':{
      c.strokeStyle=tint(blade,'#000',0.4);c.lineWidth=3.6;
      c.beginPath();c.arc(4,0,14,-1.35,1.35);c.stroke();
      c.strokeStyle=blade;c.lineWidth=1.4;c.beginPath();c.arc(4,0,15.4,-1.3,1.3);c.stroke();
      c.fillStyle=gold;c.fillRect(2,-4,4,8);
      c.strokeStyle='#efe6cf';c.lineWidth=0.9;
      lineC(c,4+14*Math.cos(-1.35),14*Math.sin(-1.35),4+14*Math.cos(1.35),14*Math.sin(1.35));
      break;}
    case'cross':{ // stock, swept limbs, drawn string, bolt in the groove
      c.fillStyle=grip;c.beginPath();c.moveTo(-8,-2.4);c.lineTo(18,-3);c.lineTo(20,0);c.lineTo(18,3);c.lineTo(-8,2.4);c.closePath();c.fill();
      c.fillStyle=rgba(gold,0.75);c.fillRect(-8,-2.4,5,4.8);
      c.strokeStyle=tint(blade,'#000',0.35);c.lineWidth=2.8;        // limbs
      c.beginPath();c.moveTo(11,-1);c.quadraticCurveTo(15,-7,13,-11);c.stroke();
      c.beginPath();c.moveTo(11,1);c.quadraticCurveTo(15,7,13,11);c.stroke();
      c.strokeStyle='#efe6cf';c.lineWidth=0.8;                      // string
      c.beginPath();c.moveTo(13,-11);c.lineTo(6,0);c.lineTo(13,11);c.stroke();
      c.fillStyle=blade;triC(c,8,-1.2,22,0,8,1.2);                  // loaded bolt
      c.fillStyle=gold;c.fillRect(9,-3.4,2.6,6.8);
      break;}
    case'none':{ // bare fists — a wrapped gauntlet, not nothing
      c.fillStyle='#5a7594';c.beginPath();c.arc(2,0,4.6,0,6.28);c.fill();
      c.fillStyle='#8aa6c4';c.beginPath();c.arc(1,-1.4,2.2,0,6.28);c.fill();
      c.strokeStyle='#cfc0a4';c.lineWidth=1;lineC(c,-2,-3,4,-3);lineC(c,-2,3,4,3);
      break;}
    default:{ // staves, wands, rods, scepters
      const len=w.art==='wand'?15:27, orb=w.art==='wand'?4:6;
      c.strokeStyle=grip;c.lineWidth=3.2;lineC(c,-7,0,len,0);
      c.strokeStyle=rgba(gold,0.6);c.lineWidth=1;lineC(c,-7,-1.1,len,-1.1);
      c.fillStyle=gold;                                               // claw setting
      c.beginPath();c.moveTo(len-5,-4);c.lineTo(len+1,0);c.lineTo(len-5,4);c.closePath();c.fill();
      const pulse=1+0.12*Math.sin(G.time*4)+(charge||0)*0.5;
      c.fillStyle=blade;c.beginPath();c.arc(len+1,0,orb*pulse,0,6.28);c.fill();
      c.fillStyle=rgba('#ffffff',0.75);c.beginPath();c.arc(len-0.6,-1.6,orb*0.34,0,6.28);c.fill();
      break;}
  }
  // Elemental flames licking along the cutting edge (bladed weapons only —
  // staves and bows carry their element in the orb/glow instead).
  if(el&&(w.art==='sword'||w.art==='great'||w.art==='dagger')){
    const len=w.art==='great'?32:w.art==='dagger'?16:28;
    c.globalAlpha=0.45+0.3*Math.sin(G.time*7);
    c.strokeStyle=el;c.lineWidth=1.3;c.shadowColor=el;c.shadowBlur=6;
    for(let i=0;i<4;i++){
      const x=6+i*(len-8)/4, ph=G.time*9+i*1.7;
      c.beginPath();c.moveTo(x,-2);
      c.quadraticCurveTo(x+2.5,-5.5-Math.sin(ph)*2.2,x+5,-2.2);c.stroke();
    }
    c.globalAlpha=1;c.shadowBlur=0;
  }
  c.restore();c.shadowBlur=0;
}

/* ================================================================
   SECTION 7: ENTITY RENDERERS
   ================================================================ */
/* Draw Player (Knight) */
function drawHero(c,p){
  const t=G.time,moving=Math.abs(p.vx)>20&&p.onGround;
  const legA=Math.sin(p.runAnim||0)*(moving?7:0);
  const bob=moving?Math.sin((p.runAnim||0)*2)*1.0:Math.sin(t*2)*0.6;
  const airborne=!p.onGround;
  // Palette comes from the equipped skin (steel-blue Warden by default).
  const PAL=curSkin().pal;
  const A=PAL.A,AL=PAL.AL,AH=PAL.AH,TR=PAL.TR,CAPE=PAL.CAPE,CAPE2=PAL.CAPE2,MET=PAL.MET,GL=PAL.GL,TONE='#f1d9c2';
  const hurt=p.hurtFlash>0;
  const charging=p.charging&&p.chargeTime>0.12;
  c.save();
  if(p.invuln>0&&Math.floor(p.invuln*20)%2===0)c.globalAlpha=0.45;
  if(p.dodgeTimer>0)c.globalAlpha=0.6;
  c.scale(p.face,1);

  // Charge aura: a soft radial bloom, never a solid shape
  if(charging){
    const q=Math.min(1,p.chargeTime/CHARGE_T);
    const col=p.chargeReady?(p.weapon.blade||'#ffffff'):'#7fa8ff';
    const R=30+q*16, pulse=0.7+0.3*Math.sin(t*22);
    const rg=c.createRadialGradient(0,-26,2,0,-26,R);
    rg.addColorStop(0,rgba(col,(0.10+0.16*q)*pulse));
    rg.addColorStop(0.55,rgba(col,(0.06+0.12*q)*pulse));
    rg.addColorStop(1,rgba(col,0));
    c.save();c.fillStyle=rg;c.fillRect(-R,-26-R,R*2,R*2);
    if(p.chargeReady){ // motes spiralling in once it's ready
      c.globalAlpha=0.7*pulse;c.fillStyle=col;
      for(let i=0;i<5;i++){const a=t*5+i*1.256,rr2=16+Math.sin(t*6+i)*7;
        c.fillRect(Math.cos(a)*rr2-1,-26+Math.sin(a)*rr2*0.8-1,2.4,2.4);}
    }
    c.restore();
  }

  // Cape — layered, sways with motion and airtime
  const sway=Math.sin(t*4)*3+(moving?6:0)-(p.vx||0)*0.02+(airborne?10:0);
  c.save();c.translate(-5,-30+bob);
  c.fillStyle=hurt?'#5a2020':CAPE2;
  c.beginPath();c.moveTo(2,-6);c.quadraticCurveTo(-16-sway,10,-13-sway*1.1,26);c.lineTo(-2,23);c.quadraticCurveTo(-4,4,5,-2);c.closePath();c.fill();
  c.fillStyle=hurt?'#7a2a2a':CAPE;
  c.beginPath();c.moveTo(2,-6);c.quadraticCurveTo(-12-sway*0.8,8,-9-sway*0.9,23);c.lineTo(-1,21);c.quadraticCurveTo(-3,4,5,-2);c.closePath();c.fill();
  c.restore();

  // Legs + greaves
  c.fillStyle='#161d27';rr(c,-8,-14,7,14+legA,2);c.fill();rr(c,2,-14,7,14-legA,2);c.fill();
  c.fillStyle=A;rr(c,-8.5,-15,8,7,2);c.fill();rr(c,1.5,-15,8,7,2);c.fill();
  c.fillStyle=MET;c.fillRect(-8,-3,7,3);c.fillRect(2,-3,7,3);

  c.save();c.translate(0,bob);
  // Torso: plate with a lit upper bevel and gold belt
  c.fillStyle=hurt?'#8a3030':A;rr(c,-10,-35,20,24,4);c.fill();
  c.fillStyle=hurt?'#b04040':AL;rr(c,-9,-34.5,18,12,3);c.fill();
  c.fillStyle=rgba(AH,0.55);rr(c,-9,-34.5,18,4,2);c.fill();          // shoulder-line highlight
  c.fillStyle=GL;c.globalAlpha=0.85+0.15*Math.sin(t*3);
  c.fillRect(-1.5,-33,3,16);                                          // chest rune
  c.globalAlpha=1;
  c.fillStyle=TR;c.fillRect(-10,-18.5,20,3);                          // gold belt
  c.fillStyle='#f3e0a8';c.fillRect(-2.5,-19,5,4);                     // buckle
  // Pauldrons
  c.fillStyle=AL;c.beginPath();c.arc(-9,-33,5.4,0,6.28);c.fill();c.beginPath();c.arc(9,-33,5.4,0,6.28);c.fill();
  c.fillStyle=rgba(AH,0.8);c.beginPath();c.arc(-9.6,-34.4,2.6,0,6.28);c.fill();c.beginPath();c.arc(8.4,-34.4,2.6,0,6.28);c.fill();
  c.fillStyle=TR;c.fillRect(-13,-31,7,1.6);c.fillRect(6,-31,7,1.6);

  // Head: closed great-helm. No face — just dark and two burning eye slits.
  c.fillStyle='#100d14';rr(c,-6,-47,12,12,3);c.fill();                // helm interior
  c.fillStyle=hurt?'#8a3030':A;                                       // faceplate
  c.beginPath();c.moveTo(-7,-46);c.lineTo(7,-46);c.lineTo(7,-40);c.lineTo(3,-40);c.lineTo(3,-43);c.lineTo(-3,-43);c.lineTo(-3,-40);c.lineTo(-7,-40);c.closePath();c.fill();
  c.fillStyle=hurt?'#8a3030':tint(A,'#000',0.3);                      // chin guard
  c.beginPath();c.moveTo(-6,-38.5);c.lineTo(6,-38.5);c.lineTo(4,-35);c.lineTo(-4,-35);c.closePath();c.fill();
  c.fillStyle=AL;c.fillRect(-7,-49.5,14,4);                           // brow band
  c.fillStyle=rgba(AH,0.7);c.fillRect(-7,-49.5,14,1.4);
  c.fillStyle=GL;c.shadowColor=GL;c.shadowBlur=7;
  c.fillRect(-3.4,-42.2,2.8,2.2);c.fillRect(0.9,-42.2,2.8,2.2);       // burning eye slits
  c.shadowBlur=0;
  c.fillStyle=CAPE;                                                    // crest plume
  c.beginPath();c.moveTo(0,-50);c.quadraticCurveTo(-7,-58,-12+Math.sin(t*5)*1.5,-52);
  c.quadraticCurveTo(-6,-52,-1,-48);c.closePath();c.fill();
  c.fillStyle=TR;c.fillRect(-1.5,-51,3,3);
  c.restore();

  // Rim light down the leading edge — cheap, and it lifts the figure off the bg
  c.save();c.globalAlpha=0.5;c.strokeStyle=AH;c.lineWidth=1.4;
  c.beginPath();c.moveTo(9,-45+bob);c.lineTo(10.5,-33+bob);c.lineTo(9.5,-19+bob);c.stroke();
  c.restore();

  // Arm + Weapon
  const w=p.weapon;
  c.save();c.translate(6,-30+bob);
  let ang = -0.45 + Math.sin(t*2)*0.05;
  let tx = 0, ty = 0; // translations for thrusts
  const swp = p.atkTimer>0 ? (1-(p.atkTimer/0.26)) : 0;
  
  if (w.cls==='melee') {
    if (p.atkTimer>0) {
      // Distinct weapon animations
      switch(w.art) {
        case 'sword':  ang = -1.2 + Math.pow(swp, 0.8) * 2.5; break;
        case 'dagger': ang = -0.6 + swp * 1.5; tx = swp * 10; ty = swp * -5; break;
        case 'spear':  ang = 0; tx = Math.sin(swp*Math.PI)*28; ty = 5; break; // Thrust
        case 'axe':    ang = -1.8 + Math.pow(swp, 1.2) * 3.0; break; // Heavy chop
        case 'great':  ang = -2.0 + Math.pow(swp, 1.5) * 3.8; break; // Slow wide sweep
        case 'hammer': ang = -2.2 + Math.pow(swp, 1.8) * 3.7; break; // Massive smash
        case 'scythe': ang = -1.5 + Math.pow(swp, 0.9) * 3.5; break; // Reaping arc
        default:       ang = -1.2 + swp * 2.5; break;
      }
    }
  } else {
    const rec=p.atkTimer>0?(p.atkTimer/0.18):0;
    ang = -0.1 + rec*0.5;
  }
  
  if(charging) ang += -0.5*Math.min(1,p.chargeTime/CHARGE_T) + Math.sin(t*30)*0.03*(p.chargeReady?1:0);
  
  c.translate(tx, ty);
  c.rotate(ang);
  c.strokeStyle=AL;c.lineWidth=5.5;c.lineCap='round';lineC(c,-2,0,8,2);
  c.strokeStyle=rgba(AH,0.6);c.lineWidth=2;lineC(c,-1,-1.4,7,0.6);
  c.translate(8,2);drawWeaponArt(c,w,charging?Math.min(1,p.chargeTime/CHARGE_T):0);
  if(w.cls==='ranged'&&p.atkTimer>0){
    const q=p.atkTimer/0.18;
    c.globalAlpha=0.85*q;c.fillStyle=elColor(w.el)||'#fff';
    c.shadowColor=elColor(w.el)||'#fff';c.shadowBlur=15;
    c.beginPath();c.arc(6+q*5,0,3+6*q,0,6.28);c.fill();c.shadowBlur=0;c.globalAlpha=1;
  }
  c.restore();

  // Swing trail: distinctly shaped and elemental colored
  if(w.cls==='melee'&&p.atkTimer>0){
    const mod=p.curSwingMod||1;
    const isThrust = (w.art === 'spear' || w.art === 'dagger');
    const R=(w.range||50)*(isThrust?0.95:0.82)*(mod>1?1.28:1);
    
    // determine start angle and sweep range based on weapon
    let a1 = -1.2, span = 0.55;
    switch(w.art) {
        case 'axe':    a1 = -1.8; span = 0.65; break;
        case 'great':  a1 = -2.0; span = 0.8; break;
        case 'hammer': a1 = -2.2; span = 0.7; break;
        case 'scythe': a1 = -1.5; span = 0.75; break;
    }
    a1 = a1 + Math.pow(swp, 1.2)*(span*4.5); // approximate arc based on current sweep
    
    const col=(w.el&&elColor(w.el))||(mod>1?(w.blade||'#fff'):'#cfe4ff');
    c.save();c.translate(6,-30+bob);c.lineCap='butt';
    c.shadowColor=col;c.shadowBlur=mod>1?20:(w.el?12:6);
    
    if (isThrust) {
        // Linear thrust trail
        c.globalAlpha = Math.max(0, 1-swp*1.5);
        c.strokeStyle = col; c.lineWidth = 4 + (mod>1?4:0);
        c.beginPath(); c.moveTo(tx, ty); c.lineTo(tx+R, ty); c.stroke();
        c.globalAlpha = 1;
    } else {
        // Arc trail
        const SEG=14;
        for(let i=0;i<SEG;i++){
          const f=i/SEG, aa=a1-f*span, ab=a1-(f+1/SEG)*span;
          if(ab < -2.4) break; // Don't trail too far behind
          c.globalAlpha=Math.max(0,(1-f)*(1-f)*0.6*(1-swp*0.5));
          c.strokeStyle=i<3?'#ffffff':col;
          c.lineWidth=(mod>1?16:8)*(1-f*0.6);
          c.beginPath();c.arc(0,0,R*(0.84+f*0.04),ab,aa);c.stroke();
        }
    }
    c.restore();c.shadowBlur=0;c.globalAlpha=1;
  }
  c.restore();
}

/* Draw Grunt — hunched monstrosity with exposed ribcage and broken teeth */
function drawGrunt(c,e,col){
  const W=e.w,H=e.h,br=Math.sin(e.bob*0.7)*0.6; // idle breathing
  const dark=tint(col,'#000',0.5),lit=tint(col,'#fff',0.15);
  // asymmetric hunched posture
  c.save(); c.translate(0, br);
  // trailing back spikes / warped spine
  c.fillStyle=dark;
  for(let i=0;i<4;i++) triC(c,-W/2+4+i*5,-H*0.9+i*2,-W/2-2+i*5,-H-8-i*2,-W/2+10+i*5,-H*0.8+i*2);
  // body
  c.fillStyle=grad(c,'gr'+col+H,0,-H,0,0,[[0,dark],[0.5,col],[1,dark]]);
  c.beginPath(); c.moveTo(-W/2,-H*0.2); c.quadraticCurveTo(-W/2-6,-H*0.7, -W*0.1,-H); c.quadraticCurveTo(W/2+4,-H*0.8, W/2,-H*0.2); c.quadraticCurveTo(W*0.4,0, 0,0); c.quadraticCurveTo(-W*0.4,0, -W/2,-H*0.2); c.fill();
  
  // exposed ribcage / bones
  c.fillStyle=rgba('#e8e5d3',0.6);
  for(let i=0;i<3;i++){
    c.fillRect(W*0.1, -H*0.6+i*6, W*0.35-i*3, 2);
    c.fillRect(-W*0.35+i*3, -H*0.6+i*6, W*0.2, 2);
  }
  c.fillStyle=rgba('#300000',0.5); c.fillRect(-W/2, -H*0.65, W, H*0.4); // dark cavity
  
  // scarred flesh
  c.strokeStyle=rgba('#4a0000',0.6); c.lineWidth=1.5;
  c.beginPath(); c.moveTo(-W*0.2, -H*0.3); c.lineTo(W*0.2, -H*0.1); c.stroke();
  
  // arms (lopsided)
  c.fillStyle=dark;
  rr(c,-W/2-4,-H*0.6,6,H*0.5,2);c.fill();
  rr(c,W/2-1,-H*0.45,4,H*0.6,2);c.fill();
  
  // twisted face
  c.fillStyle=dark;c.fillRect(-W*0.4,-H*0.8,W*0.8,6);
  const eg=e.element?elColor(e.element):'#ff3333';
  c.save();c.shadowColor=eg;c.shadowBlur=12;
  // erratic eyes
  const eyeTwitch=Math.sin(G.time*12+e.bob)*2;
  eyes(c,eyeTwitch,-H*0.72,'#0a0000',eg);
  // extra eye
  c.beginPath();c.arc(-W*0.2+eyeTwitch,-H*0.85, 2, 0, 6.28); c.fill();
  c.restore();
  
  // broken jagged teeth
  c.fillStyle='#d4d0b8';
  for(let i=0;i<4;i++) triC(c,-4+i*3,-H*0.5, -2.5+i*3,-H*0.5+5, -1+i*3,-H*0.5);
  c.fillStyle=rgba('#000000',0.6);c.fillRect(-6,-H*0.52,14,2);
  // dripping black fluid
  if(Math.random()<0.1) G.particles.push({x:e.x+(Math.random()-0.5)*10, y:GROUND_Y-e.y-H*0.45, vx:0, vy:-10, sz:2, color:'#111', life:0.4});
  c.restore();
}

/* Silhouette accents for the expanded roster. They ride the established grunt /
   flyer rigs, so all existing hit flashes, status tints and gravity transforms work. */
function drawEnemyVariant(c,e){
  if(e.type==='rifthound'){
    c.save();c.fillStyle='#221331';c.strokeStyle='#c9a2ff';c.lineWidth=2;
    c.beginPath();c.moveTo(e.w*0.18,-e.h*0.72);c.lineTo(e.w*0.7,-e.h*0.55);
    c.lineTo(e.w*0.62,-e.h*0.34);c.lineTo(e.w*0.16,-e.h*0.4);c.closePath();c.fill();c.stroke();
    c.fillStyle='#f1d6ff';c.beginPath();c.arc(e.w*0.47,-e.h*0.52,2.4,0,6.283);c.fill();
    c.strokeStyle='#382048';c.lineWidth=5;
    for(const x of [-e.w*0.28,e.w*0.2]){c.beginPath();c.moveTo(x,-7);c.lineTo(x-5,4);c.stroke();}
    c.restore();
  }else if(e.type==='sporecaster'){
    c.save();c.shadowColor='#9fd84a';c.shadowBlur=10;
    c.fillStyle='#4c6f32';c.beginPath();c.ellipse(0,-e.h*0.86,e.w*0.72,9,0,0,6.283);c.fill();
    c.fillStyle='#b6e878';
    for(let i=-2;i<=2;i++){c.beginPath();c.arc(i*6,-e.h*0.88+Math.abs(i)*1.2,1.6,0,6.283);c.fill();}
    c.shadowBlur=0;c.strokeStyle='#92724b';c.lineWidth=3;
    c.beginPath();c.moveTo(e.w*0.45,-4);c.lineTo(e.w*0.58,-e.h*0.8);c.stroke();
    c.fillStyle='#9fd84a';c.beginPath();c.arc(e.w*0.58,-e.h*0.82,4,0,6.283);c.fill();
    c.restore();
  }else if(e.type==='stormmote'){
    c.save();c.translate(0,-e.h*0.5);c.rotate(G.time*2.8);
    c.strokeStyle='#c9f4ff';c.lineWidth=2;c.shadowColor='#9fe0ff';c.shadowBlur=12;
    c.beginPath();c.ellipse(0,0,e.w*0.72,e.h*0.28,0,0,6.283);c.stroke();
    c.rotate(Math.PI/2);c.beginPath();c.ellipse(0,0,e.w*0.55,e.h*0.22,0,0,6.283);c.stroke();
    c.fillStyle='#ffffff';c.beginPath();c.arc(0,0,3.5,0,6.283);c.fill();c.restore();
  }
}

/* Draw Flyer — tattered wings, multiple misaligned eyes, dangling horrors */
function drawFlyer(c,e,col){
  const flap=Math.sin(e.bob*2.4),W=e.w,H=e.h,cy=-H/2;
  const dark=tint(col,'#000',0.5),lit=tint(col,'#fff',0.15);
  const eg=e.element?elColor(e.element):'#ff3333';
  const span=W*1.15, rise=flap*H*0.6;
  for(const s of [-1,1]){
    c.save();c.scale(s,1);
    // membrane: tattered trailing edge with holes
    c.fillStyle=rgba(dark,0.9);
    c.beginPath();c.moveTo(3,cy-2);
    c.quadraticCurveTo(span*0.55,cy-8-rise,span,cy-2-rise*1.1); // leading edge
    c.lineTo(span*0.8,cy+5-rise*0.5); c.lineTo(span*0.9,cy+12-rise*0.4); // tattered tear
    c.lineTo(span*0.6,cy+4-rise*0.5);
    c.lineTo(span*0.5,cy+14-rise*0.3); c.lineTo(span*0.4,cy+6-rise*0.2); // another tear
    c.quadraticCurveTo(span*0.26,cy+12,span*0.14,cy+5);
    c.lineTo(span*0.1,cy+10); c.lineTo(3,cy+3);
    c.closePath();c.fill();
    
    // exposed bone structures
    c.strokeStyle=rgba('#a39f8f',0.6);c.lineWidth=1.5;
    for(let i=1;i<=3;i++){
      c.beginPath();c.moveTo(4,cy-1);
      c.quadraticCurveTo(span*0.4,cy-4-rise*0.7,span*(0.2+i*0.25),cy+6-rise*(0.2+i*0.2));
      c.stroke();
    }
    c.fillStyle=rgba('#d4d0b8',0.8); // bone claws
    triC(c,span-2,cy-2-rise*1.1,span+5,cy-6-rise*1.1,span-3,cy+2-rise);
    c.restore();
  }
  // body
  c.fillStyle=grad(c,'fl'+col+H,0,-H,0,0,[[0,dark],[0.5,col],[1,dark]]);
  c.beginPath();
  c.moveTo(0,cy-H*0.4); c.quadraticCurveTo(W*0.4,cy-H*0.2, W*0.3,cy+H*0.4);
  c.quadraticCurveTo(0,cy+H*0.6, -W*0.3,cy+H*0.4); c.quadraticCurveTo(-W*0.4,cy-H*0.2, 0,cy-H*0.4);
  c.fill();
  
  // exposed flesh/core
  c.fillStyle=rgba('#3a0000',0.6); c.beginPath(); c.ellipse(0,cy+H*0.1,W*0.2,H*0.15,0,0,6.28); c.fill();
  
  // Multiple misaligned eyes
  c.save();c.shadowColor=eg;c.shadowBlur=12;
  c.fillStyle=eg;
  const eyeTwitch=Math.sin(G.time*15+e.bob)*1.5;
  c.beginPath();c.arc(-W*0.15+eyeTwitch, cy-H*0.1, 2.5, 0, 6.28); c.fill();
  c.beginPath();c.arc(W*0.1-eyeTwitch, cy-H*0.2, 2.5, 0, 6.28); c.fill();
  c.beginPath();c.arc(W*0.18+eyeTwitch, cy+H*0.05, 1.5, 0, 6.28); c.fill();
  if(e.creepy){
    for(let i=0;i<4;i++){const a=i*1.8+e.bob*0.4;
      c.beginPath();c.arc(Math.cos(a)*W*0.2,cy+Math.sin(a)*H*0.25,2.5,0,6.28);c.fill();}
    c.fillStyle=rgba('#8a0000',0.85); // weeping blood
    c.fillRect(-2,cy+H*0.1,2,H*0.4+Math.sin(e.bob*1.8)*3);
    c.fillRect(W*0.15,cy-H*0.1,1.5,H*0.3);
  }
  c.restore();
  
  // dangling horror appendage
  c.strokeStyle=dark; c.lineWidth=2;
  c.beginPath(); c.moveTo(0, cy+H*0.5);
  const dangle = cy+H*0.5 + 10 + Math.sin(e.bob*3)*5;
  c.quadraticCurveTo(Math.sin(e.bob*4)*8, dangle-5, Math.sin(e.bob*2)*12, dangle);
  c.stroke();
  
  // dark particle trail
  if(Math.random()<0.2) G.particles.push({x:e.x+(Math.random()-0.5)*W*0.5, y:GROUND_Y-e.y-H/2, vx:(Math.random()-0.5)*10, vy:Math.random()*20, sz:3, color:dark, life:0.5});
}

/* Draw Boss — Dark Souls style massive monstrosity with glowing cracks and chains */
function drawBoss(c,e,col){
  const t=G.time,H=e.h,W=e.w,en=e.lunge>0||e.phase>=2;
  const dark=tint(col,'#000',0.6),lit=tint(col,'#fff',0.1);
  const eyeGlow=en?'#ff1a1a':(e.shot?(e.shot.color||'#ff661a'):'#ff661a');
  const br=Math.sin(t*2)*1.2; // heavy breathing
  
  // Phase 2 transformation visuals
  if(en && Math.random()<0.15) {
    G.particles.push({x:e.x+(Math.random()-0.5)*W*1.2, y:GROUND_Y-e.y-Math.random()*H, vx:0, vy:-30-Math.random()*40, sz:2+Math.random()*3, color:eyeGlow, life:0.6});
  }

  // Menacing aura — suffocating darkness + elemental glow
  c.save();
  const ar=c.createRadialGradient(0,-H*0.5,W*0.1,0,-H*0.5,W*(en?1.5:1.1));
  ar.addColorStop(0,rgba(eyeGlow,0.3+0.1*Math.sin(t*6)));
  ar.addColorStop(0.5,rgba(dark,0.4));
  ar.addColorStop(1,rgba('#000',0));
  c.fillStyle=ar;c.fillRect(-W*1.5,-H*1.8,W*3,H*2.5);
  c.restore();
  if(e.spellSiphonFight){
    c.save();
    if(e.spellStunT>0){
      c.strokeStyle='#dff8ff';c.lineWidth=3;c.shadowColor='#8fe0ff';c.shadowBlur=14;
      for(let i=0;i<7;i++){const a=i/7*6.2832;
        c.beginPath();c.moveTo(Math.cos(a)*W*0.45,-H*0.5+Math.sin(a)*H*0.45);
        c.lineTo(Math.cos(a)*W*0.82,-H*0.5+Math.sin(a)*H*0.72);c.stroke();}
    }else{
      c.strokeStyle=rgba('#8fe0ff',0.55+0.2*Math.sin(t*6));c.lineWidth=3;
      c.shadowColor='#7fd6ff';c.shadowBlur=12;
      c.beginPath();c.ellipse(0,-H*0.5,W*0.78,H*0.72,0,0,6.28);c.stroke();
    }
    c.restore();
  }
  if(e.forgeFight){
    c.save();
    if(e.forgeStunT>0){
      c.strokeStyle='#d7f4ff';c.lineWidth=4;c.shadowColor='#9ee9ff';c.shadowBlur=18;
      for(let i=0;i<8;i++){
        const a=i/8*6.2832,ix=Math.cos(a)*W*0.25,iy=-H*0.5+Math.sin(a)*H*0.24;
        c.beginPath();c.moveTo(ix,iy);
        c.lineTo(Math.cos(a)*W*0.5,-H*0.5+Math.sin(a)*H*0.48);
        c.lineTo(Math.cos(a+0.18)*W*0.7,-H*0.5+Math.sin(a+0.18)*H*0.67);c.stroke();
      }
    }else{
      c.strokeStyle=rgba('#ff7b24',0.65+0.18*Math.sin(t*5));c.lineWidth=5;
      c.shadowColor='#ff5a18';c.shadowBlur=18;
      c.beginPath();c.ellipse(0,-H*0.5,W*0.78,H*0.72,0,0,6.28);c.stroke();
      c.strokeStyle=rgba('#ffc05a',0.45);c.lineWidth=2;
      c.beginPath();c.ellipse(0,-H*0.5,W*0.66,H*0.61,0,0,6.28);c.stroke();
    }
    c.restore();
  }
  if(e.paradoxFight){
    c.save();
    if(e.paradoxStunT>0){
      c.strokeStyle='#f2dcff';c.lineWidth=3;c.shadowColor='#d08aff';c.shadowBlur=18;
      for(let i=0;i<9;i++){
        const a=i/9*6.2832,r1=W*(0.28+(i%2)*0.08),r2=W*(0.72+(i%3)*0.05);
        c.beginPath();c.moveTo(Math.cos(a)*r1,-H*0.5+Math.sin(a)*r1);
        c.lineTo(Math.cos(a+0.12)*r2,-H*0.5+Math.sin(a+0.12)*r2);c.stroke();
      }
    }else{
      c.strokeStyle=rgba('#c47bff',0.58+0.2*Math.sin(t*7));c.lineWidth=3;
      c.shadowColor='#b06bff';c.shadowBlur=16;
      c.beginPath();c.ellipse(0,-H*0.5,W*0.84,H*0.76,t*0.2,0,6.28);c.stroke();
      c.beginPath();c.ellipse(0,-H*0.5,W*0.68,H*0.62,-t*0.28,0,6.28);c.stroke();
    }
    c.restore();
  }
  
  const TT=-H*0.85, HT=-H; // Hunched posture
  const TB=-H*0.2;
  
  // Damaged Legs / Robes
  c.fillStyle=dark;
  c.beginPath(); c.moveTo(-W*0.4, 0); c.lineTo(-W*0.2, TB); c.lineTo(W*0.2, TB); c.lineTo(W*0.4, 0); 
  c.lineTo(W*0.1, -10); c.lineTo(-W*0.1, -10); c.closePath(); c.fill();
  // chains hanging from waist
  c.strokeStyle='#444'; c.lineWidth=2;
  for(let i=0;i<4;i++) {
    c.beginPath(); c.moveTo(-W*0.3+i*W*0.2, TB+br); 
    c.quadraticCurveTo(-W*0.3+i*W*0.2 + Math.sin(t*3+i)*5, TB+15, -W*0.3+i*W*0.2 + Math.sin(t*4+i)*8, TB+25+Math.sin(e.bob+i)*5); 
    c.stroke();
  }

  // Massive, jagged Torso
  c.fillStyle=grad(c,'bs'+col+H,0,TT,0,TB,[[0,lit],[0.3,col],[0.8,dark],[1,'#000']]);
  c.beginPath();
  c.moveTo(-W*0.45, TT+br); c.lineTo(W*0.45, TT+br); // broad shoulders
  c.lineTo(W*0.35, TB-br); c.lineTo(-W*0.35, TB-br); // narrow waist
  c.closePath(); c.fill();
  
  // Glowing Cracks / Veins (Phase transformation)
  if(e.phase>=2){
    c.strokeStyle=eyeGlow; c.lineWidth=2; c.shadowColor=eyeGlow; c.shadowBlur=8;
    c.beginPath(); c.moveTo(0, TT+10+br); c.lineTo(-10, TT+30+br); c.lineTo(-5, TT+50+br); c.stroke();
    c.beginPath(); c.moveTo(5, TT+20+br); c.lineTo(15, TT+40+br); c.lineTo(8, TT+60+br); c.stroke();
    c.shadowBlur=0;
  }
  
  // Exposed pulsing core
  c.save();c.shadowColor=eyeGlow;c.shadowBlur=15;
  const pulse=1+0.2*Math.sin(t*8);
  c.fillStyle=rgba(eyeGlow,0.7);
  c.beginPath();c.arc(0, TT+H*0.4+br, 8*pulse, 0, 6.28); c.fill();
  c.fillStyle='#fff'; c.beginPath(); c.arc(0, TT+H*0.4+br, 3*pulse, 0, 6.28); c.fill();
  c.restore();

  // Jagged Pauldrons
  c.fillStyle=dark;
  triC(c,-W*0.45,TT+br+10, -W*0.7,TT-15+br, -W*0.2,TT+br);
  triC(c,W*0.45,TT+br+10, W*0.7,TT-15+br, W*0.2,TT+br);
  
  // Head
  c.fillStyle=dark;
  c.beginPath(); c.arc(0, HT+br+10, W*0.25, 0, 6.28); c.fill();
  
  if(e.type==='king'){
    // Corrupted Crown
    c.fillStyle='#8a764d';c.shadowColor='#c47bff';c.shadowBlur=en?15:5;
    for(let i=-2;i<=2;i++){triC(c, i*10-4, HT+15+br, i*10, HT-15-Math.abs(i)*5+br, i*10+4, HT+15+br);}
    c.shadowBlur=0;
  } else if(e.type==='tyrant'){
    // Void Halo & Horns
    c.strokeStyle=rgba('#8a4fd0',0.6); c.lineWidth=3;
    c.beginPath(); c.ellipse(0, HT+br, W*0.4, H*0.1, Math.sin(t)*0.2, 0, 6.28); c.stroke();
    c.fillStyle='#111'; triC(c,-W*0.1,HT+br+5, -W*0.4,HT-25+br, -W*0.2,HT+br+15);
                       triC(c,W*0.1,HT+br+5, W*0.4,HT-25+br, W*0.2,HT+br+15);
  } else {
    // Twisted Horns
    c.fillStyle='#222';
    c.beginPath(); c.moveTo(-W*0.15, HT+br+5); c.quadraticCurveTo(-W*0.5, HT-10+br, -W*0.3, HT-30+br); c.lineTo(-W*0.05, HT+br+5); c.fill();
    c.beginPath(); c.moveTo(W*0.15, HT+br+5); c.quadraticCurveTo(W*0.5, HT-10+br, W*0.3, HT-30+br); c.lineTo(W*0.05, HT+br+5); c.fill();
  }
  
  // Piercing Eyes
  c.save();c.shadowColor=eyeGlow;c.shadowBlur=15;
  eyes(c,0,HT+br+10,'#0a0000',eyeGlow);
  if(e.phase>=2) { // extra eyes when enraged
    eyes(c,0,HT+br+2,'#0a0000',eyeGlow);
  }
  c.restore();
}

/* ================================================================
   SECTION 8: CORE GAME LOGIC
   ================================================================ */
function freshPlayer(){
  return{x:80,y:0,w:26,h:44,vx:0,vy:0,face:1,onGround:true,jumps:0,maxJumps:2,hasSlam:false,
    hp:100,maxHp:100,level:1,xp:0,xpNext:46,weapon:startWeapon(),gear:freshGear(),armorMods:null,
    stats:{power:1.0,speed:1.0,atkSpeed:1.0,lifesteal:0,dodgeCd:0.75},
    atkTimer:0,atkCd:0,swingId:0,swingT:0,swingHits:[],dodgeTimer:0,dodgeCdT:0,dashX:1,invuln:0,hurtFlash:0,runAnim:0,dead:false,slamming:false,mods:{},adrenT:0,
    ckX:70,ckY:0,coyote:0,jumpBuf:0,floorPlat:null,keys:0,slamCd:0,
    atkBuf:0,dashBuf:0,sqV:0,dustT:0,wallCoyote:0,lastWallDir:1,airRefill:false};
}

/* The full arc: base game -> NG+1 -> NG+2 -> the dawn. */
const STORY={
  intro0:[
    "For centuries, the Abyss King slumbered beneath the world.",
    "His nightmares bled into the soil, corrupting the woods\u2026",
    "\u2026raising storms in the canyons, and turning one hollow upside down.",
    "You are the last Warden.",
    "Descend. Break the cycle."],
  outro0:[
    "The Abyss King has been shattered\u2026",
    "\u2026but his death-cry echoes through the rift.",
    "Below the broken throne, the crown is already reforming.",
    "This is not the end. The descent continues.",
    "Prepare for the second descent."],
  intro1:[
    "The rift did not close.",
    "The Abyss remembers your blade \u2014 and it has been sharpening.",
    "Every stone. Every spike. Every lie. Crueler now.",
    "Descend again, Warden. Cut deeper."],
  outro1:[
    "Twice slain \u2014 and still the King laughs from below.",
    "Something older stirs beneath his throne\u2026",
    "\u2026the thing that dreamed HIM.",
    "One descent remains. The last one.",
    "Prepare for the final descent."],
  intro2:[
    "The last descent.",
    "The Abyss knows your name now. It says it in your sleep.",
    "There will be no fourth chance \u2014 for either of you.",
    "End it."],
  finale:[
    "The crown shatters \u2014 and this time, stays shattered.",
    "Far above, light pours into the Hollow for the first time in centuries.",
    "The woods forget their lies. The Inversion rights itself.",
    "The miners walk home singing, lanterns swinging.",
    "The last Warden climbs into the dawn, and rests.",
    "The cycle is broken."]
};
function beginRun(ngPlus,carrySnap,scales,opts){
  queueLevelUp=0;
  const p=carrySnap?freshFromSnapshot(carrySnap):freshPlayer();
  recomputeArmor(p);
  if(!scales)scales=carrySnap?computeNgScales(p):{hp:1,dmg:1};
  G={p,stageIndex:0,enemies:[],particles:[],texts:[],pickups:[],projectiles:[],obstacles:[],aoes:[],shadows:[],cam:0,shake:0,
     ngPlus:ngPlus||0,ngHp:scales.hp,ngDmg:scales.dmg,baseLoadout:snapOf(p),portal:null,stageBanner:0,
     killGoal:0,kills:0,boss:null,time:0,tookDamage:false,combo:0,comboT:0,leverActive:0,
     runStats:{dmg:0,taken:0,kills:0,gold:0,best:null},
     runCompletion:{done:0,total:0,stages:{}},runCoinFound:{},
     leaderboardEligible:!(opts&&(opts.levelSelect||opts.testRun)),leaderboardSubmitted:false};
  if((ngPlus||0)>0)meta.ngPlus=Math.max(meta.ngPlus,ngPlus);
  meta.lastNgHp=scales.hp;meta.lastNgDmg=scales.dmg;persist();
  
  const startPlay = () => {
    if(opts&&opts.bossRush){setupBossRush();}
    else{loadStage((opts&&opts.startStage)||0);}
    mode='play';showOverlay(false);showGameUI(true);hudUpdate();
  };

  // Tier intros play only when a descent BEGINS (title / entering NG+),
  // never on a death retry.
  if (opts && opts.intro) {
      const tier=Math.min(ngPlus||0,2);
      mode = 'cutscene'; showGameUI(false); showOverlay(false);
      playCutscene(STORY['intro'+tier], 'intro', startPlay);
  } else {
      startPlay();
  }
}
function playCutscene(lines, type, onComplete) {
    const cs = document.getElementById('cutscene');
    const ct = document.getElementById('cutText');
    const cv = document.getElementById('cutCanvas');
    const ctx = cv.getContext('2d');
    cv.width = window.innerWidth; cv.height = window.innerHeight;
    cs.classList.remove('hide'); cs.classList.remove('fadein');
    let index = 0; let seqObj = { active: true, to: null, frame: null, t: 0 };
    
    /* Staged, illustrated scenes — the beat advances with the narration line. */
    const draw = () => {
        if (!seqObj.active) return;
        seqObj.t += 0.016;
        const w = cv.width, h = cv.height, T = seqObj.t;
        const beat = Math.max(0,Math.min(4, index-1));   // which line is showing
        const gy = h*0.78;                                // horizon

        if (type === 'intro') {
          // Sky deepens from dusk to abyssal as the story descends
          const sky = ctx.createLinearGradient(0,0,0,h);
          const k = beat/4;
          sky.addColorStop(0, tint('#1a2233', '#0c0716', k));
          sky.addColorStop(0.6, tint('#2b3a56', '#1a0f2e', k));
          sky.addColorStop(1, '#05060a');
          ctx.fillStyle = sky; ctx.fillRect(0,0,w,h);

          // Corruption bleeding up out of the ground, stronger each beat
          const cg = ctx.createLinearGradient(0,gy-160,0,gy);
          cg.addColorStop(0,'rgba(140,60,220,0)');
          cg.addColorStop(1,`rgba(140,60,220,${0.05+k*0.22})`);
          ctx.fillStyle = cg; ctx.fillRect(0,gy-160,w,160);

          // Two ridgelines for depth — overlapped so no sky shows between humps
          for(const L of [{c:tint('#141c30','#0d0718',k),s:1.0,hb:60,o:0},
                          {c:tint('#080c16','#05030c',k),s:0.72,hb:110,o:70}]){
            ctx.fillStyle=L.c;
            for(let i=-1;i<11;i++){
              const px=i*(w/8)+L.o, hh=(L.hb+hash1(i*7+L.o)*90)*L.s;
              ctx.beginPath();ctx.moveTo(px-105,gy+4);
              ctx.quadraticCurveTo(px,gy-hh,px+105,gy+4);ctx.closePath();ctx.fill();
            }
          }
          // The King's spire rises from beat 1
          if(beat>=1){
            const a=Math.min(1,(beat-1)*0.6+0.4);
            ctx.save();ctx.globalAlpha=a;
            ctx.fillStyle='#0d0718';
            ctx.beginPath();ctx.moveTo(w*0.5-46,gy);ctx.lineTo(w*0.5-14,gy-230-Math.sin(T*0.4)*4);
            ctx.lineTo(w*0.5+14,gy-230-Math.sin(T*0.4)*4);ctx.lineTo(w*0.5+46,gy);ctx.closePath();ctx.fill();
            ctx.fillStyle=`rgba(196,123,255,${0.5+0.3*Math.sin(T*2)})`;
            ctx.shadowColor='#c47bff';ctx.shadowBlur=26;
            ctx.beginPath();ctx.arc(w*0.5,gy-238,7,0,6.28);ctx.fill();ctx.shadowBlur=0;
            ctx.restore();
          }
          ctx.fillStyle='#04050a';ctx.fillRect(0,gy,w,h-gy);   // ground
          ctx.fillStyle=`rgba(140,60,220,${0.10+k*0.2})`;ctx.fillRect(0,gy,w,2);
          // The last Warden stands against it, from beat 3
          if(beat>=3&&G&&G.p){
            ctx.save();ctx.translate(w*0.28,gy);ctx.scale(2.2,2.2);
            const savedT=G.time;G.time=T;                 // let the cape breathe
            drawHero(ctx,Object.assign({},G.p,{x:0,y:0,face:1,vx:0,onGround:true,
              runAnim:0,hurtFlash:0,invuln:0,dodgeTimer:0,atkTimer:0,charging:false}));
            G.time=savedT;ctx.restore();
          }
          // embers rising
          for(let i=0;i<40;i++){
            const x=(i*137+Math.sin(T*0.5+i)*20)%w, y=gy-((i*61+T*28)%(gy));
            ctx.globalAlpha=0.10+0.35*Math.abs(Math.sin(T+i));
            ctx.fillStyle='#c47bff';ctx.fillRect(x,y,2,2);
          }
          ctx.globalAlpha=1;
        } else if (type === 'dawn') {
          // FINALE: a sun rises over the Hollow for the first time in centuries.
          const sunY = h*0.62 - Math.min(h*0.25, T*12);
          const sky = ctx.createLinearGradient(0,0,0,h);
          sky.addColorStop(0,'#2a1e3e');sky.addColorStop(0.55,'#7a4a3a');sky.addColorStop(1,'#e8a33d');
          ctx.fillStyle=sky;ctx.fillRect(0,0,w,h);
          const rg2=ctx.createRadialGradient(w/2,sunY,10,w/2,sunY,h*0.5);
          rg2.addColorStop(0,'rgba(255,236,170,0.95)');rg2.addColorStop(0.3,'rgba(255,200,90,0.45)');rg2.addColorStop(1,'rgba(255,200,90,0)');
          ctx.fillStyle=rg2;ctx.fillRect(0,0,w,h);
          ctx.fillStyle='#ffecaa';
          ctx.beginPath();ctx.arc(w/2,sunY,34,0,6.28);ctx.fill();
          ctx.fillStyle='#1a1420';                                   // the Hollow's rim
          for(let i=0;i<=10;i++){
            const px=i*(w/10), hh=60+Math.abs(Math.sin(i*3.7))*90;
            ctx.beginPath();ctx.moveTo(px-90,h);ctx.quadraticCurveTo(px,h-hh,px+90,h);ctx.closePath();ctx.fill();
          }
          // the Warden, resting on the rim at last
          if(beat>=3&&G&&G.p){
            ctx.save();ctx.translate(w*0.5,h-96);ctx.scale(1.8,1.8);
            const sT=G.time;G.time=T;
            drawHero(ctx,Object.assign({},G.p,{x:0,y:0,face:1,vx:0,onGround:true,
              runAnim:0,hurtFlash:0,invuln:0,dodgeTimer:0,atkTimer:0,charging:false}));
            G.time=sT;ctx.restore();
          }
          for(let i=0;i<40;i++){                                     // rising light motes
            const x=(i*97.3)%w, y=h-((i*61+T*36)%(h*0.8));
            ctx.globalAlpha=0.25+0.4*Math.abs(Math.sin(T+i));
            ctx.fillStyle='#ffe9a8';ctx.fillRect(x,y,2.4,2.4);
          }
          ctx.globalAlpha=1;
        } else {
          // OUTRO: the Tyrant shatters; a rift tears open and holds
          ctx.fillStyle='#07040c';ctx.fillRect(0,0,w,h);
          const cx=w/2, cy2=h*0.44;
          const burst=Math.min(1,T/1.6);
          // shockwave rings
          for(let r=0;r<3;r++){
            const rad=(T*260+r*160)%Math.max(w,h);
            ctx.strokeStyle=`rgba(255,94,84,${Math.max(0,0.5-rad/Math.max(w,h)*0.5)})`;
            ctx.lineWidth=3;ctx.beginPath();ctx.arc(cx,cy2,rad,0,6.28);ctx.stroke();
          }
          // shards flying outward
          for(let i=0;i<70;i++){
            const a=i*2.399+T*0.2, d=40+((i*17+T*180)%Math.max(w,h)*0.7);
            ctx.save();ctx.translate(cx+Math.cos(a)*d, cy2+Math.sin(a)*d*0.75);
            ctx.rotate(a+T*2);
            ctx.globalAlpha=Math.max(0,0.85-d/(Math.max(w,h)*0.6));
            ctx.fillStyle=i%3?'#8a4fd0':'#ff5e54';
            ctx.fillRect(-3,-1.5,7,3);ctx.restore();
          }
          ctx.globalAlpha=1;
          // the rift
          const rg=ctx.createRadialGradient(cx,cy2,4,cx,cy2,120+Math.sin(T*3)*10);
          rg.addColorStop(0,'#fff');rg.addColorStop(0.18,'#c47bff');
          rg.addColorStop(0.5,'rgba(90,30,150,0.5)');rg.addColorStop(1,'rgba(90,30,150,0)');
          ctx.fillStyle=rg;
          ctx.save();ctx.translate(cx,cy2);ctx.scale(0.42+0.05*Math.sin(T*2),1);
          ctx.beginPath();ctx.arc(0,0,120*burst,0,6.28);ctx.fill();ctx.restore();
          ctx.fillStyle='#000';
          ctx.save();ctx.translate(cx,cy2);ctx.scale(0.2,1);
          ctx.beginPath();ctx.arc(0,0,64*burst,0,6.28);ctx.fill();ctx.restore();
          // the crown, falling — all that's left of him
          if(beat>=1){
            const fy=cy2+ (T*26)%260;
            ctx.save();ctx.translate(cx+Math.sin(T*1.2)*40, fy);ctx.rotate(T*0.8);
            ctx.globalAlpha=0.8;ctx.fillStyle='#f7d79a';
            for(let i=-2;i<=2;i++){ctx.beginPath();ctx.moveTo(i*7,0);ctx.lineTo(i*7+3,-11);ctx.lineTo(i*7+6,0);ctx.closePath();ctx.fill();}
            ctx.fillRect(-15,0,30,4);ctx.restore();ctx.globalAlpha=1;
          }
        }
        seqObj.frame = requestAnimationFrame(draw);
    };
    
    const end = () => { if(!seqObj.active) return; seqObj.active = false; clearTimeout(seqObj.to); cancelAnimationFrame(seqObj.frame); cs.classList.add('hide'); onComplete(); };
    const showNext = () => {
        if(!seqObj.active) return;
        if(index >= lines.length) { end(); return; }
        ct.innerHTML = lines[index]; cs.classList.add('fadein'); clearTimeout(seqObj.to);
        seqObj.to = setTimeout(() => {
            if(!seqObj.active) return; cs.classList.remove('fadein'); seqObj.to = setTimeout(showNext, 800);
        }, Math.max(3000, lines[index].length * 50));
        index++;
    };
    cs.onclick = (e) => {
        if (e.target.id === 'cutSkip') { end(); }
        else if (cs.classList.contains('fadein')) { cs.classList.remove('fadein'); clearTimeout(seqObj.to); seqObj.to = setTimeout(showNext, 400); }
    };
    seqObj.to = setTimeout(showNext, 500);
    seqObj.frame = requestAnimationFrame(draw);
}
function freshFromSnapshot(snap){
  const p=freshPlayer();p.stats=Object.assign(p.stats,snap.stats);
  p.weapon=snap.weapon?JSON.parse(JSON.stringify(snap.weapon)):startWeapon();
  p.gear=cloneGear(snap.gear);p.maxHp=snap.maxHp||100;p.maxJumps=snap.maxJumps||2;p.hasSlam=!!snap.hasSlam;p.hasJetpack=!!snap.hasJetpack;p.fuel=p.hasJetpack?100:0;p.level=snap.level||1;p.mods=Object.assign({},snap.mods||{});
  p.xp=0;p.xpNext=Math.round(46+p.level*34+p.level*p.level*2);
  recomputeArmor(p);p.hp=effMaxHp(p);return p;
}
function computeNgScales(p){
  const off=Math.pow(Math.max(1,(p.weapon.dmg*effPower(p)*effAtkSpeed(p)/Math.max(.14,p.weapon.cd))/(9/.4)),0.85);
  const tuf=Math.pow(Math.max(1,(effMaxHp(p)/100)/(1-defenseR(p))),0.85);
  return{hp:Math.min(500,Math.max(off*1.05,(meta.lastNgHp||1)*1.08)),dmg:Math.min(500,Math.max(tuf*1.05,(meta.lastNgDmg||1)*1.08))};
}
function showGameUI(v){['hud','controls','pausebtn'].forEach(id=>document.getElementById(id).classList.toggle('hide',!v));}

/* Chunk grid: 120px columns, 40px rows, read bottom-up. Gaps on the mandatory route
   stay within a plain double jump (~210px reach), so nothing here demands a dash the
   player may not have discovered; wider gaps always come with a spring, mover or wall.
   X floor · S spiked floor · C crumbling · B brittle(slam) · Z ice (slides) ·
   M/N mover h/v · P spring · T ceiling trap · L wall · < > spiked wall face ·
   K lever · D door · U ceiling spikes · I invisible ledge · F fake ledge ·
   V hidden spring · O crystal · W fake loot · Q powerup block · R rare loot */
const CHUNKS=[
  // — Stepping stones over a pit
  [".......",
   ".......",
   "..X.X..",
   "XX...XX"],
  // — Staircase up and back down
  [".......",
   "...X...",
   "..X.X..",
   "XX...XX"],
  // — Spiked floor run: time the gaps
  [".......",
   ".......",
   ".......",
   "XXSXSXX"],
  // — Crumbling bridge; don't stop
  [".......",
   ".......",
   "..CCC..",
   "XX...XX"],
  // — Spring up to a high shelf, drop back down
  [".......",
   "...X...",
   ".......",
   "XXPXXXX"],
  // — Horizontal mover ferry
  [".......",
   ".......",
   "...M...",
   "XX...XX"],
  // — Vertical elevator up to a ledge
  ["....XX.",
   ".......",
   "..N....",
   "XXX....",
   "XXX...."],
  // — Ceiling traps over a clear floor: bait, then walk through
  [".......",
   "..T.T..",
   ".......",
   "XXXXXXX"],
  // — Trap over a mover: it lands and becomes a step
  ["...T...",
   ".......",
   "...M...",
   "XX...XX"],
  // — Wall chimney. Walls start high so the ground road stays open.
  ["..L.L..",
   "..L.L..",
   "..L.L..",
   ".......",
   "XXXXXXX"],
  // — Spiked chimney: faces alternate, one side is always safe.
  //   The golden block at the top is why you bother.
  ["...Q...",
   "..>.<..",
   "..L.L..",
   "..>.<..",
   ".......",
   "XXXXXXX"],
  // — Spring vault: the launch smashes through the brittle lid — the only
  //   road to the rare prize floating above. No ground slam required.
  ["...R...",
   ".......",
   "..BBB..",
   ".......",
   ".......",
   ".......",
   ".......",
   "XXXPXXX"],
  // — Lever and door: hit it, then run the corridor before it shuts
  [".......",
   ".......",
   "K.....D",
   "XXXXXXD",
   "XXXXXXX"],
  // — Lever high, door low: climb for the switch, then run the gate
  //   (used to have the door on the APPROACH side — an instant softlock
  //   once gates were sealed against hopping)
  ["..K....",
   "..XX...",
   ".......",
   "......D",
   "XXXXXXD"],
  // — Spring gauntlet over spiked ground
  [".......",
   ".......",
   "...C...",
   "XPSSSPX"],
  // — Fake ledge over the real path
  [".......",
   "..FFF..",
   ".......",
   "XX.X.XX"],
  // — Crystal over the crossing: refresh mid-air for the high line,
  //   or take the humble stone below
  ["...O...",
   ".......",
   "...X...",
   "XX...XX"],
  // — A gift in the rafters: bonk the golden block
  ["...Q...",
   ".......",
   ".......",
   "XXXXXXX"],
  // — Icy floor: momentum carries you — brake early or eat the spike
  [".......",
   ".......",
   ".......",
   "XZZZZSX"],
  // — Ice run into a spring: let the slide carry you into the launch
  [".......",
   ".......",
   ".......",
   "XZZZPXX"],
  // — Conveyor sprint: the belt hurls you toward the spike — jump in time
  [".......",
   ".......",
   ".......",
   "XEEEESX"],
  // — Headwind: the belt fights you all the way to the golden block
  ["...Q...",
   ".......",
   ".......",
   "XHHHHHX"],
  // — Updraft shaft: ride the rising air, drift onto the high shelf
  ["....R..",
   "....XX.",
   ".......",
   "XA....X"],
  // — Wind ferry: islands linked by a column of rising air
  [".......",
   ".......",
   ".......",
   "X..A..X"],
  // — Moon bubble: gravity forgets you over the wide gap — float across
  [".......",
   "..GGG..",
   ".......",
   "XX...XX"],
];
// The Leap of Faith: a spike lane no jump can clear — unless you trust the
// middle. (V = floor tile hiding an invisible spring, disguised with a
// decorative fake spike so the whole lane reads as uniformly deadly —
// nothing marks the safe tile.) Nine tiles wide: a standing jump from the
// start can't reach anywhere near the far side, but the spring's own launch
// carries you the rest of the way. Kept OUT of the regular CHUNKS pool and
// force-placed on a per-stage roll instead — otherwise it also lands by
// plain chance on top of that roll, pushing its real frequency well past
// the "occasional" feel intended.
const LEAP_OF_FAITH_CHUNK=[
   ".......",
   ".......",
   ".......",
   "XSSSVSSSX"];

/* ================================================================
   HAND-CRAFTED LEVELS (stages 1-3)
   Coordinates: x = world x (center of object), y = height above ground line.
   ================================================================ */
/* --- NG+2 "The Ceiling" geometry ---------------------------------------------
   Inverted gravity pulls the player UP, so they come to rest hanging on the
   underside of whatever slab is lowest. Anything they need to touch has to sit
   at that hang height, not above the slab. Player anchor y sits 40px below the
   surface bottom (see getCeiling). */
const CEIL_Y=1600;                 // ceiling slab (h=40) -> bottom 1560
const HANG_SLAB=CEIL_Y-40-40;      // 1520: standing under the ceiling proper
const STALAC_Y=CEIL_Y-190;         // 1410: hanging shelves (h=14) -> bottom 1396
const HANG_STALAC=STALAC_Y-14-40;  // 1356: standing under a shelf
const VOID_Y=HANG_SLAB;            // cursed loot rests on the ceiling floor
function Pl(x,w,y,o){return Object.assign({type:'plat',x,w,y,h:14,x0:x,y0:y},o);}
function Gr(x1,x2){return Pl((x1+x2)/2,x2-x1,0,{deep:1,h:20});}
/* A genuine ramp: the surface height interpolates linearly across the span
   instead of one flat y, so rolling terrain (hills, dips, S-curves) reads and
   plays as a real slope, not a staircase of tiny ledges. x1/x2 are the span's
   world-space edges (left/right), y0/y1 the surface height at each edge —
   chain slopes by matching one's y1 to the next's y0 for a seamless line. */
function Slope(x1,x2,y0,y1){return{type:'plat',x:(x1+x2)/2,w:x2-x1,y:Math.max(y0,y1),h:20,slope:true,slopeY0:y0,slopeY1:y1,deep:1};}
function Sp(x,y,o){return Object.assign({type:'spikes',x,w:100,y,period:2.4,phase:0,upT:1.0,dmg:12},o);}
/* Furnace jets reuse the proven timed-hazard collision, but render as fire rather
   than metal. Their longer warning window makes precision rooms learnable. */
function FJ(x,y,o){return Object.assign(Sp(x,y,o),{flame:1,dmg:16});}
const SPIKE_REACH=24;   // how far wall spikes jut out from the face they're mounted on
/* Wall spikes: mounted ON a wall face (x = the face, not the wall centre) so they
   actually reach a clinging player. face -1 juts left, +1 juts right. */
function WSp(x,y,face,o){return Object.assign({type:'spikes',wall:1,face,x,y,len:80,w:SPIKE_REACH*2,period:2.4,phase:0,upT:1.0,dmg:12},o);}
/* Wall you can cling to and jump off. Occupies world y from (y-h) up to y. */
function Wl(x,y,h,w){return{type:'wall',x,y,h,w:w||26};}
/* SLATE — the only surface a PLAYER mouth holds on. Everywhere else the stone
   spits a portal out. Levels put slate exactly where the intended solution needs
   it, so placing a mouth becomes a real decision. Slate() is a portalable floor
   panel; SlateWall() a portalable wall (the player clings to a face and the mouth
   ejects away from it). */
function Slate(x,w,y){return Object.assign(Pl(x,w,y||0,{}),{slate:1,h:16});}
function SlateWall(x,y,h){return Object.assign(Wl(x,y,h),{slate:1});}
/* Brittle rock: only a ground-slam breaks it. Reforms after `reform` seconds. */
function Br(x,w,y,o){return Object.assign(Pl(x,w,y,{brittle:1,reform:4.5,h:16}),o);}
/* Ice: near-zero ground friction while standing on it — you keep sliding
   whichever way you were already moving, and steering barely bites. */
function Ice(x,w,y,o){return Object.assign(Pl(x,w,y,{ice:1}),o);}
/* Air crystal: touch it mid-air to refill your jumps and dash. Winks out for a
   moment, then reforms — chains of them make sky routes. */
function Cry(x,y){return{type:'crystal',x,y,w:56,cdT:0,spin:Math.random()*6.28};}
/* Pressure plate: weighted by the player, a walker enemy, or a landed trap block.
   latch=true means it clicks down permanently. Wired to gates via the same id space
   as levers — a gate opens if EITHER its lever is running or its plate is pressed. */
function Plate(x,y,id,latch,crateOnly){return{type:'plate',x,y,id,latch:!!latch,crateOnly:!!crateOnly,pressed:false,down:0,w:60};}
function FollowerPlate(x,y,id){return Object.assign(Plate(x,y,id,true,false),{
  followerOnly:1,followerReward:'armor'
});}
/* Pushable crate: walk into it to shove it. Falls with gravity, weights plates,
   can be stood on, and respawns at its start if it drops into a pit — so a
   crate puzzle can never be softlocked. */
function Crate(x,y){return{type:'crate',x,y,x0:x,y0:y,yPrev:y,w:36,h:34,vy:0,resetF:0};}
/* The Portal: two player-placed mouths. Crates AND the player ride them. Safe
   against sequence breaks because a mouth can only be planted where you already
   stand, on solid ground \u2014 it is fast travel to visited places, never a skip. */
/* ===== Crate-Portal mechanic =================================================
   Two player-placed mouths that ferry the player, crates, escorts and even
   projectiles. Each mouth remembers the surface it was set on and the direction
   it ejects — its world-space normal, where +y is UP:
     floor   -> (0, 1)  ejects up
     ceiling -> (0,-1)  ejects down   (set while standing on a flipped ceiling)
     wall    -> (-wallDir, 0)         away from the face you clung to
   Transit PRESERVES SPEED and launches along the exit normal — speedy thing in,
   speedy thing out. Level designers can also drop always-linked `lportal` pairs
   (optionally timed, or emitting an updraft) — every pair funnels through the
   same transit code. */
/* The slate the player is standing on. Scanned directly, because a normal ground
   plat can share the same surface height and win the p.floorPlat slot — which is
   exactly why "WON'T HOLD" fired even while standing on a slate. */
function playerSlate(p){
  const feet = G.gravityFlipped ? (p.y+p.h) : p.y;
  for(const o of G.obstacles){
    if(!o.slate||o.type!=='plat')continue;
    if(Math.abs(p.x-o.x)<o.w/2+p.w/2 && Math.abs(feet-o.y)<16) return o;
  }
  return null;
}
/* One recovery path for every player-mouth reset. A checkpoint rewind must never
   drop the player back into a stale pair, and clearing also disarms the mouth-touch
   guard so the next pair behaves like a genuinely fresh placement. */
function clearPlacedPortals(announce){
  if(!G)return false;
  const had=!!(G.cratePortals&&G.cratePortals.length);
  G.cratePortals=[];
  if(G.boss&&G.boss.echoFight)G.boss.portalHijack=null;
  if(G.echoTrial&&G.echoTrial.active){
    G.echoTrial=null;
    for(const o of G.obstacles)if(o.type==='echoSigil'){o.lit=false;o.pulse=0;}
  }
  if(G.p){G.p._restMouth=null;G.p._tpCd=0;}
  if(announce&&had)addText(G.p.x,GROUND_Y-G.p.y-70,'PORTALS CLEARED','#9aa4b4',false);
  return had;
}
function placePortal(){
  const p=G.p;if(!G.cratePortals)G.cratePortals=[];
  if(G.echoTrial&&G.echoTrial.active){
    addText(p.x,GROUND_Y-p.y-70,'THE ECHO HOLDS THE PAIR','#d8b7ff',false);
    if(meta.soundOn)SFX.hit();
    return;
  }
  let nx,ny,px=p.x,py=Math.max(0,p.y),surf,surfObj=null;
  if(p.onWall){ surf='wall'; nx=-p.wallDir; ny=0; py=Math.max(20,p.y+p.h*0.4); surfObj=p.wallObj; px=p.x+p.wallDir*2; }
  else if(p.onGround && G.gravityFlipped){ surf='ceiling'; nx=0; ny=-1; surfObj=playerSlate(p)||p.floorPlat; }
  else if(p.onGround){ surf='floor'; nx=0; ny=1; surfObj=playerSlate(p)||p.floorPlat; }
  else { addText(p.x,GROUND_Y-p.y-70,'STAND ON A SURFACE TO SET A MOUTH','#9aa4b4',false); return; }
  // Mouths hold ONLY on slate — the pale rune-etched panels. Bare stone rejects them.
  if(!surfObj||!surfObj.slate){ addText(px,GROUND_Y-py-70,"WON'T HOLD — FIND THE SLATE",'#e0b050',false); if(meta.soundOn)SFX.hit();
    for(let i=0;i<6;i++)G.particles.push({x:px+(Math.random()-0.5)*24,y:GROUND_Y-py-20,vx:(Math.random()-0.5)*120,vy:-40-Math.random()*80,sz:2,color:'#e0b050',life:0.3}); return; }
  // An anchor only commandeers your kit into single-mouth mode while you're NEAR its
  // puzzle. Walk on and your own two-mouth blue/orange kit is yours again.
  const anchorLive=G.lportals&&Object.values(G.lportals).some(m=>m.length===1&&m[0].anchor&&!m[0].gone&&Math.abs(m[0].x-p.x)<1500);
  if(anchorLive){
    // A fixed exit is waiting — you only ever set ONE mouth; a fresh press MOVES it.
    G.cratePortals.length=0;
  } else if(G.cratePortals.length>=2){
    clearPlacedPortals(true);
    return;
  }
  const mouth={x:px,y:py,t:0,nx,ny,surf};
  G.cratePortals.push(mouth);
  const n=G.cratePortals.length;
  // You're standing ON the mouth you just set — don't yank yourself through it this
  // instant. Arm it so it only fires once you STEP OFF and come back (or drop in).
  p._restMouth=mouth; p._tpCd=Math.max(p._tpCd||0,0.15);
  addText(px,GROUND_Y-py-70,(n===1&&!anchorLive)?'MOUTH SET — PLACE ITS TWIN':'MOUTH SET','#4fc3ff',true);
  if(n===2&&G.boss&&G.boss.paradoxFight){
    const align=tyrantPairStatus(G.boss);
    addText((G.cratePortals[0].x+G.cratePortals[1].x)*0.5,
      GROUND_Y-Math.max(G.cratePortals[0].y,G.cratePortals[1].y)-82,
      align.message,align.ok?'#9dffc4':'#d8b7ff',true);
  }
  if(meta.soundOn)SFX.magic();
  for(let i=0;i<10;i++)G.particles.push({x:px+(Math.random()-0.5)*30,y:GROUND_Y-py-20-(Math.random()*40),vx:(Math.random()-0.5)*160,vy:(Math.random()-0.5)*160,sz:2+Math.random()*3,color:n===1?'#4fc3ff':'#ff9a3b',life:0.5});
}
/* A level portal mouth. dir is one of floor/ceiling/wallL/wallR. o may carry
   {period,phase,duty} to make the pair pulse on/off, or {emit:'updraft'}. */
function LPortal(x,y,group,dir,o){
  const N={floor:[0,1],ceiling:[0,-1],wallL:[-1,0],wallR:[1,0]}[dir]||[0,1];
  return Object.assign({type:'lportal',x,y,pg:group,nx:N[0],ny:N[1],t:Math.random()*6},o||{});
}
/* Is a (possibly timed) level portal mouth currently open? */
function lportalOpen(m){
  if(!m||!m.period)return true;
  const t=((G.time+(m.phase||0))%m.period+m.period)%m.period;
  return t < m.period*(m.duty||0.6);
}
/* Every active portal PAIR this frame:
   - the player's own two mouths (blue↔orange),
   - each level portal group with two mouths both open,
   - each ACTIVE ANCHOR (a single fixed level mouth) paired with the player's
     first placed mouth — the level pins the exit, YOU place the entry. */
function portalPairs(){
  const pairs=[];
  const playerFirst=(G.cratePortals&&G.cratePortals.length>=1)?G.cratePortals[0]:null;
  const px=G.p?G.p.x:0;
  if(G.cratePortals&&G.cratePortals.length===2&&!(G.echoTrial&&G.echoTrial.active))
    pairs.push([G.cratePortals[0],G.cratePortals[1],'#4fc3ff','#ff9a3b']);
  if(G.lportals)for(const grp in G.lportals){
    const m=G.lportals[grp];
    // An ANCHOR pairs with the player's placed mouth, but only while the player is
    // NEAR its puzzle (proximity gate) — walk on and the anchor lets go, so your own
    // blue/orange kit is yours again everywhere else. The pair is ONE-WAY: the mouth
    // you place is the ENTRANCE, the level's mouth is the EXIT (5th slot = oneWay).
    // One-way is what stops a self-fling from falling back through its own exit.
    if(m.length===1&&m[0].anchor&&!m[0].gone&&playerFirst&&Math.abs(m[0].x-px)<1500){
      pairs.push([playerFirst,m[0],'#4fc3ff',m[0].col||'#ff9a3b',true]);
    }
    else if(m.length===2&&lportalOpen(m[0])){const c=m[0].col||'#b06bff';pairs.push([m[0],m[1],c,c]);}
  }
  return pairs;
}
function portalBurst(a,b,ca,cb){
  for(const pc of [[a,ca],[b,cb]])for(let i=0;i<10;i++)
    G.particles.push({x:pc[0].x+(Math.random()-0.5)*24,y:GROUND_Y-pc[0].y-26,vx:(Math.random()-0.5)*200,vy:(Math.random()-0.5)*200,sz:2+Math.random()*3,color:pc[1],life:0.5});
}
/* Transit an entity through whichever mouth it's touching. ent needs
   {x,y,vx,vy,_tpCd,_restMouth} and optionally h. Preserves speed, launches along
   the exit normal. Returns the exit mouth on transit, else null. */
function portalTransit(ent,dt,centered){
  if(ent._tpCd>0)ent._tpCd-=dt;
  const pairs=portalPairs();
  if(!pairs.length)return null;
  // Actors store y at their feet and integrate with y-=vy. Projectiles store y at
  // their centre and integrate with y+=vy, so they need the opposite vertical sign.
  const eh=(ent.h||40), ecy=centered?ent.y:ent.y+eh*0.5;
  for(const pr of pairs){
    const oneWay=pr[4];
    for(let pi=0;pi<2;pi++){
      if(oneWay&&pi===1)continue;   // anchor pairs only fire entering the PLACED mouth (pr[0])
      const a=pr[pi], b=pr[1-pi];
      const hit=Math.abs(ent.x-a.x)<30 && Math.abs(ecy-(a.y+20))<36;
      if(hit && ent._restMouth!==a && (ent._tpCd||0)<=0){
        // Payload mouths are selective one-way relays. Emberdeep's fixed exit
        // admits its traveler but rejects the player, crates and projectiles.
        if(b.payload==='escort'&&!(ent.kind==='escort'&&ent.relay)){
          a._sputter=0.3;ent._restMouth=a;
          if(ent===G.p){
            addText(a.x,GROUND_Y-a.y-70,'THE RELAY SEEKS A TRAVELER','#7fe8ff',false);
            if(meta.soundOn)SFX.hit();
          }
          continue;
        }
        const incoming=Math.hypot(ent.vx||0,ent.vy||0);
        // HUNGRY mouths: a puzzle can demand a minimum entry speed. Too slow and
        // the mouth sputters and spits you back — no transit, no words, just a
        // flicker that says "come faster". This is the momentum gate.
        const gate=Math.max(a.minSpeed||0,b.minSpeed||0);
        if(gate && incoming<gate){
          a._sputter=0.3;
          for(let i=0;i<5;i++)G.particles.push({x:a.x+(Math.random()-0.5)*22,y:GROUND_Y-a.y-24,vx:(Math.random()-0.5)*110,vy:-30-Math.random()*80,sz:2+Math.random()*2,color:pr[3]||'#ff9a3b',life:0.25});
          ent._restMouth=a;                   // don't re-poll while they sit on it
          if(ent===G.p&&meta.soundOn)SFX.hit();
          continue;
        }
        // Most mouths preserve momentum (wide flings). A mouth can instead pin its
        // exit speed with `ejectSpeed`: the entry gate still demands a big plunge to
        // pass, but you're spat out gently — so the drop is survivable ONLY by an
        // active tool (the jetpack), not by the raw fall.
        const s=(b.ejectSpeed!=null)?b.ejectSpeed:Math.max(150,Math.min(1400,incoming));
        const off=36;
        ent.x=b.x + b.nx*off;
        ent.y=Math.max(0, b.y + b.ny*off);
        ent.vx=b.nx*s;
        ent.vy=(centered?1:-1)*b.ny*s;
        ent._tpCd=0.7; ent._restMouth=b;
        ent._portalEntry=a;ent._portalExit=b;
        portalBurst(a,b,pr[2],pr[3]);
        if(meta.soundOn)SFX.magic();
        G.shake=Math.min(G.shake+3,8);
        return b;
      }
      if(!hit && ent._restMouth===a)ent._restMouth=null;
    }
  }
  return null;
}
/* Air above a gate is sealed: a door you can hop, fly or roof-walk around is a
   suggestion, not a gate. No cling — that's what doors already promise. */
function DoorSeal(x,topY,capY){return{type:'wall',x,w:30,y:capY||topY+430,h:(capY||topY+430)-topY,slickL:1,slickR:1};}
/* Sequence lever: strike the group's levers in engraved order. Wrong order resets
   the whole group. Completing it opens the group's circuit permanently. */
function SeqLever(x,y,group,order){return{type:'lever',x,y:y||0,seq:group,order,timer:0,dur:0,flip:0};}
/* Hidden coin — one per stage, persisted account-wide in meta.coins. Collect all
   COIN_TOTAL and the Vault beyond the Abyss King opens. */
function CoinOb(x,y){return{type:'coin',x,y,w:26,taken:false};}
/* NPCs: 'escort' follows once greeted and must survive to the portal;
   'fetch' wants their lost lantern (a qitem placed elsewhere) brought back. */
function NPC(x,kind){return{x,y:0,vy:0,kind,state:'idle',asked:false,done:false,hp:3,hitCd:0,flash:0,face:1,bob:Math.random()*6,w:26};}
/* Mario-style ?-block: bonk it from below and a timed powerup pops out. */
function PBox(x,y,power){return{type:'plat',x,w:36,y,h:26,x0:x,y0:y,pbox:power};}
const POWERS={
  star :{name:'Void Star',    icon:'★', dur:8,  col:'#ffd700', desc:'invincible — foes shatter on touch'},
  giant:{name:'Titan Draught',icon:'◆', dur:10, col:'#ff7a3a', desc:'colossal power — crush by contact'},
  cloak:{name:'Phantom Cloak',icon:'◐', dur:8,  col:'#b9a5e8', desc:'unseen — nothing hunts you'},
  boots:{name:'Storm Boots',  icon:'⚡', dur:10, col:'#7fd6ff', desc:'blinding speed, endless dashes'}};
const COIN_TOTAL=14, BONUS_STAGE=14, SECRET_STAGE=15;
function coinCount(){return Object.keys(meta.coins||{}).length;}
function Sign(x,y,text){return{type:'sign',x,y,text};}
function Check(x,y){return{type:'check',x,y:y||0,active:0};}
function Spring(x,y,pow){return{type:'spring',x,y:y||0,pow:pow||930,anim:0};}
function Lever(x,y,id,dur){return{type:'lever',x,y:y||0,id,dur,timer:0,flip:0};}
/* Portal-puzzle signal pieces. Emitters provide a guaranteed shot even when the
   current weapon is melee; receivers only accept a projectile after a portal hop,
   so ranged gear cannot bypass the intended route. Puzzle bolts never hurt foes. */
function RuneEmitter(x,y,dir,o){return Object.assign({type:'runeEmitter',x,y,dir:dir||'right',period:1.8,cool:0.7,flash:0},o||{});}
function RuneReceiver(x,y,id){return Object.assign(Lever(x,y,id,1e9),{runeSensor:1,portalOnly:1});}
function PortalBountyPlate(x,y,id){return Object.assign(Plate(x,y,id,true,false),{
  enemyOnly:1,portalEnemyOnly:1,portalReward:'armor'
});}
function EchoSigil(x,y,slot){return{type:'echoSigil',x,y,slot,lit:false,pulse:0,w:64,h:64};}
function SpellSiphon(x,y,boss){return{type:'spellSiphon',x,y,w:68,h:92,boss,charge:0,max:3,flash:0};}
function ForgeCoolant(x,y,boss){return{type:'forgeCoolant',x,y,w:82,h:116,boss,flash:0,hits:0};}
function Trap(x,y){return{type:'trap',x,y,w:74,h:58,state:'idle',warnT:0,vy:0};}

